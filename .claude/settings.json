{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "mcp__SnykMCP",
      "Bash(snyk *)",
      "Bash(npx snyk *)",
      "Bash(pnpm dlx snyk *)"
    ]
  },
  "mcpServers": {
    "graphify": {
      "command": "graphify",
      "args": [".", "--mcp"]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  }
}