# Ambiente local do WSO2 Identity Server. Copie para .env:
#
#   cp .env.example .env
#
# Estes valores são de DESENVOLVIMENTO. Em produção tudo isto vem do Secret
# Manager — ver docs/INFRA-IDENTITY.md.

# --- Postgres dedicado ------------------------------------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres-local

# Role da aplicação. O IS nunca se conecta como superuser.
DB_USER=wso2carbon
DB_PASSWORD=wso2carbon-local

# 5433 e não 5432: a api da plataforma já usa a 5432 no host.
DB_HOST_PORT=5433

# --- Identity Server --------------------------------------------------------
SERVER_HOSTNAME=localhost
IS_HTTPS_PORT=9443
IS_HTTP_PORT=9763

ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@Unooria1

# Senha do admin do tenant criado pelo bootstrap.
TENANT_ADMIN_PASSWORD=Admin@Unooria1

# Keystore de demonstração da distribuição — senha pública `wso2carbon`.
# Só aceitável em localhost. Ver o aviso em conf/repository/conf/deployment.toml.
KEYSTORE_PASSWORD=wso2carbon
TRUSTSTORE_PASSWORD=wso2carbon

JVM_MEM_OPTS=-Xms512m -Xmx2048m

# --- Bootstrap --------------------------------------------------------------
# Um contrato = um tenant. Em produção este valor é o mesmo `vars.CONTRATO` que
# o .github/workflows/deploy.yml já usa.
CONTRATO=dev-local

# Callback do Auth.js v5 no hub. O path é literal: vem do `id: "wso2"` em
# apps/hub/lib/auth.ts. Não invente outro.
HUB_CALLBACK_URL=http://localhost:3000/api/auth/callback/wso2

# Usuários de teste (um por perfil).
SEED_PASSWORD=Estudante@Unooria1

# Casa com a escola criada por apps/api/prisma/seed.ts.
ESCOLA_DEMO_ID=escola-demo
