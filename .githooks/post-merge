#!/usr/bin/env bash
# Enterra a frente que acabou de ser mergeada.
#
# O merge do PR acontece no GitHub, e NENHUM hook local dispara nele. O
# primeiro momento em que esta máquina fica sabendo é o `git pull` em
# `dev-local` — que é exatamente quando este hook roda. Sem ele, o worktree
# terminado fica de pé até alguém se lembrar, segurando a branch contra
# `git branch -d` e reservando uma porta de Vite que ninguém usa (ADR-103).
#
# NUNCA falha o pull: qualquer erro aqui sai como aviso e o exit é 0. E nunca
# remove trabalho — `pnpm worktree limpar` pula worktree sujo e o que estiver
# em uso. Escape: PULAR_PODA_DE_WORKTREE=1 git pull
#
# Também mantém FRESCO o grafo do graphify (ADR-125): `graphify-out/` é ignorado
# pelo git, e o `pnpm worktree criar` copia o grafo DESTA cópia para cada frente
# nova. Sem atualizar aqui a cada pull, o grafo das frentes seria um retrato
# velho. `graphify update .` é só código (sem custo de IA) e leva minutos, então
# roda em SEGUNDO PLANO. Escape: PULAR_GRAFO=1 git pull
set -u

# Só na cópia principal: num worktree, --git-dir aponta para .git/worktrees/<slug>.
[ "$(git rev-parse --git-dir)" = "$(git rev-parse --git-common-dir)" ] || exit 0

# Só quando o merge foi para dev-local — é a base que define "mergeada".
[ "$(git rev-parse --abbrev-ref HEAD)" = "dev-local" ] || exit 0

RAIZ="$(git rev-parse --show-toplevel)"

# 1) O grafo do graphify. Só onde ele já existe (quem não usa graphify não paga
# nada) e com trava: dois pulls seguidos não disparam duas atualizações.
if [ "${PULAR_GRAFO:-}" != "1" ] && command -v graphify >/dev/null 2>&1 && [ -f "$RAIZ/graphify-out/graph.json" ]; then
  TRAVA="$RAIZ/graphify-out/.atualizando"
  if [ -n "$(find "$TRAVA" -mmin -15 2>/dev/null)" ]; then
    echo "→ o grafo do graphify já está sendo atualizado"
  else
    echo "→ atualizando o grafo do graphify em segundo plano (escape: PULAR_GRAFO=1)"
    touch "$TRAVA"
    ( cd "$RAIZ" && PYTHONHASHSEED=0 nohup sh -c 'graphify update . ; rm -f graphify-out/.atualizando' >graphify-out/atualizacao.log 2>&1 & ) || rm -f "$TRAVA"
  fi
fi

# 2) A poda das frentes mergeadas. Sem frente aberta, não há o que podar (e não
# paga o custo de subir o node).
if [ "${PULAR_PODA_DE_WORKTREE:-}" != "1" ] && [ -d "$RAIZ/.claude/worktrees" ] && [ -n "$(ls -A "$RAIZ/.claude/worktrees" 2>/dev/null)" ]; then
  echo ""
  echo "→ podando as frentes já mergeadas em dev-local (escape: PULAR_PODA_DE_WORKTREE=1)"
  node "$RAIZ/scripts/worktree.mjs" limpar || echo "  (a poda falhou; rode 'pnpm worktree limpar' à mão)"
fi
exit 0
