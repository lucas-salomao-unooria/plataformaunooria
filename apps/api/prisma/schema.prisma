// Schema da api — evolução do schema do projeto origem (Instanooria) para o
// monorepo multi-tenant. Diferenças estruturais em relação ao origem:
//
// 1. TENANCY: `escolas`/`turmas` novas; TODA tabela de dados de estudante carrega
//    `escola_id` NOT NULL denormalizado + RLS (política na migration — Prisma
//    não modela RLS). A api conecta com role sem ownership e as queries rodam
//    dentro de transação com `set_config('app.escola_id', ..., true)`.
// 2. PAPÉIS: estudante | professor | gestor | admin-contrato (origem tinha
//    professor|estudante|analista; analista → admin-contrato).
// 3. `users.username` é único POR ESCOLA (não mais global).
// 4. Absorve as tabelas do scaffold (`progresso`, `telemetria_eventos`) e as
//    novas `experiencias` (manifesto de versões) e `ia_uso_diario` (quota).
//
// Os CHECK constraints vivem na migration (Prisma não os modela); os campos
// correspondentes são TEXT/SMALLINT e a validação de aplicação é feita com zod.

generator client {
  provider      = "prisma-client-js"
  /**
   * `native` é o binário da máquina que gerou (macOS em dev); o segundo é o
   * do node:20-slim (Debian + OpenSSL 3) usado no Dockerfile e no Cloud Run.
   * Sem ele a imagem sobe e morre no primeiro query com "Query engine
   * library for current platform could not be found".
   */
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Tenant nível 2 (nível 1 é o contrato = stack inteira). O id é texto e é o
/// MESMO valor que circula no claim `escola_id` do JWT e no `set_config` da RLS.
model Escola {
  id           String   @id
  nome         String
  /// Código INEP — o `orgs.identifier` do OneRoster. É por onde a escola daqui
  /// se reconhece na base da rede (e, quando o padrão nacional do MEC cobrar,
  /// no EducaDados). Opcional: contrato pode começar sem ele.
  codigoInep   String?  @map("codigo_inep")
  /// escola | regional | rede — CHECK na migration.
  ///
  /// `regional` cobre Diretoria de Ensino (SP), polo, regional e secretaria
  /// municipal: é o nível que agrupa unidades dentro de uma rede. O `district`
  /// do OneRoster é mapeado para cá na importação.
  tipo         String   @default("escola")
  /// A REGIONAL a que esta unidade pertence. Serve para MONTAR a lista de
  /// escolas de uma diretoria — o insumo da lotação em lote —, nunca para
  /// autorizar: quem autoriza é a lotação.
  ///
  /// OBRIGATÓRIO quando `tipo = 'escola'` (CHECK na migration), e o pai tem de
  /// ser `regional` — nunca `rede` (trigger). Nulo aqui é só para a própria
  /// regional. Escola órfã fazia o filtro da tela não particionar a lista e a
  /// lotação em lote cobrir menos do que parecia cobrir (ADR-79).
  paiId        String?  @map("pai_id")
  /// A regional que a plataforma criou sozinha, para a rede sem divisão
  /// administrativa. No máximo uma (índice único PARCIAL na migration); o nome
  /// nasce `Rede` e é EDITÁVEL — o nome real da rede não existe no banco,
  /// porque o contrato é a stack e não uma linha.
  regionalPadrao Boolean @default(false) @map("regional_padrao")
  /// `sourcedId` desta org no sistema de origem (SIS da rede). Chave de
  /// reconciliação da importação — nunca é o id daqui.
  fonteId      String?  @map("fonte_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  /// Município e UF: numa rede estadual são 5 mil escolas em centenas de
  /// municípios, e sem eles a lista de escolas é impossível de navegar.
  municipio String? @map("municipio")
  /// Sigla de 2 letras — CHECK na migration.
  uf        String?

  pai             Escola?          @relation("EscolaPai", fields: [paiId], references: [id])
  filhas          Escola[]         @relation("EscolaPai")
  turmas          Turma[]
  usuarios        User[]
  lotacoes        Lotacao[]
  perfisPortateis PerfilPortatil[]
  /// Os `gestor_regional` que cobrem esta regional (vazio numa `escola`).
  gestoresRegionais User[]         @relation("RegionalDoGestor")
  /// As exceções de disponibilidade DESTE escopo — vale tanto para uma unidade
  /// (`tipo='escola'`) quanto para uma regional, que é o nível de cima na mesma
  /// tabela. As do CONTRATO não aparecem aqui: elas têm `escola_id` nulo.
  disponibilidades  Disponibilidade[]

  @@map("escolas")
}

/// Vínculo de uma PESSOA com uma ESCOLA (≈ `roles.csv` do OneRoster: papel no
/// nível da organização, datado).
///
/// `lotação` é o termo que a rede pública usa para a alocação de um servidor a
/// uma unidade, e é exatamente isto: o professor tem lotação em mais de uma
/// escola — o caso que `users.escola_id` sozinho não conseguia representar. O
/// ESTUDANTE tem uma só ativa; trocar de escola é transferência, que encerra a
/// anterior.
///
/// FORA da RLS, de propósito e pelo mesmo motivo de `users`/`turmas`: é lida no
/// LOGIN, antes de se saber a escola — é ela que responde "quais escolas são
/// suas". Uma política por `escola_id` aqui esconderia justamente a resposta.
model Lotacao {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId     String    @map("escola_id")
  usuarioId    String    @map("usuario_id") @db.Uuid
  /// estudante | professor | gestor — CHECK na migration
  papel        String
  /// A escola padrão da pessoa: alimenta o cache `users.escola_id` e é a que o
  /// token carrega quando ela entra sem escolher.
  principal    Boolean   @default(false)
  inicio       DateTime  @db.Date
  /// Preenchido em vez de DELETE quando a pessoa sai da escola.
  fim          DateTime? @db.Date
  fonteId      String?   @map("fonte_id")
  atualizadoEm DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  escola  Escola @relation(fields: [escolaId], references: [id], onDelete: Cascade)
  usuario User   @relation("LotacaoUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([escolaId, usuarioId, papel])
  @@index([usuarioId])
  @@index([escolaId, papel])
  @@map("lotacoes")
}

/// O PERFIL PORTÁTIL recebido de outra instalação da plataforma.
///
/// Um contrato é uma rede e uma stack: a criança que sai da rede estadual para a
/// municipal sai da instalação, e não há JOIN possível entre os dois bancos. O
/// que atravessa é um DOCUMENTO ASSINADO, emitido pela origem a pedido do
/// titular (LGPD art. 18 V) e importado pelo destino como um ato dele.
///
/// **O que vem de fora nunca se mistura com o que foi produzido aqui.** Esta
/// linha não vira matrícula, progresso nem perfil da Vila, e não entra em média
/// nenhuma: é a afirmação de OUTRA instalação sobre a criança, possivelmente de
/// outra versão do mapeamento. Separada, o professor lê as duas e sabe qual é
/// qual; misturada, ela ficaria indistinguível do dado local.
model PerfilPortatil {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId        String   @map("escola_id")
  estudanteId     String   @map("estudante_id") @db.Uuid
  emissorContrato String   @map("emissor_contrato")
  emissorHub      String   @map("emissor_hub")
  emissorNome     String?  @map("emissor_nome")
  emitidoEm       DateTime @map("emitido_em") @db.Timestamptz(6)
  /// O documento como veio — a fonte para reprocessar, nunca a nossa cópia
  /// interpretada.
  documento       Json
  assinatura      String
  /// verificada | nao-verificada — CHECK na migration. Assinatura INVÁLIDA nunca
  /// chega aqui: a api recusa. Não conseguir falar com o emissor é limitação de
  /// rede; assinatura quebrada é adulteração.
  verificacao     String
  importadoPor    String   @map("importado_por") @db.Uuid
  importadoEm     DateTime @default(now()) @map("importado_em") @db.Timestamptz(6)

  escola       Escola @relation(fields: [escolaId], references: [id], onDelete: Cascade)
  estudante    User   @relation("PerfilPortatilEstudante", fields: [estudanteId], references: [id], onDelete: Cascade)
  quemImportou User   @relation("PerfilPortatilImportador", fields: [importadoPor], references: [id])

  @@unique([escolaId, estudanteId, emissorContrato, emitidoEm], map: "perfis_portateis_documento_unico")
  @@index([escolaId, estudanteId], map: "perfis_portateis_por_estudante")
  @@map("perfis_portateis")
}

/// Ano letivo e seus recortes (≈ `academicSessions` do OneRoster).
///
/// É catálogo do CONTRATO, não da escola: sem `escola_id` e sem RLS, mesmo
/// precedente de `planos_referencias`. Uma rede inteira compartilha o calendário
/// e duplicá-lo por escola só criaria 100 linhas divergentes.
///
/// É esta tabela que faz a virada do ano parar de reescrever a história: sem
/// ela, `users.turma_id` é uma coluna, o 8A vira 9A em fevereiro e todo o
/// acumulado do ano anterior passa a ser lido pela turma nova, em silêncio.
model PeriodoLetivo {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// ano_letivo | semestre | bimestre | trimestre — CHECK na migration
  tipo         String   @default("ano_letivo")
  titulo       String
  ano          Int      @db.SmallInt
  inicio       DateTime @db.Date
  fim          DateTime @db.Date
  /// Hierarquia do padrão: ano letivo → bimestre. Null = raiz.
  paiId        String?  @map("pai_id") @db.Uuid
  fonteId      String?  @map("fonte_id")
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  pai    PeriodoLetivo?  @relation("PeriodoPai", fields: [paiId], references: [id])
  filhos PeriodoLetivo[] @relation("PeriodoPai")
  turmas Turma[]

  @@unique([tipo, titulo])
  @@map("periodos_letivos")
}

model Turma {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId        String   @map("escola_id")
  /// A turma existe DENTRO de um ano letivo. NOT NULL de propósito: turma sem
  /// período é a coluna `users.turma_id` de novo, só que com outro nome.
  periodoLetivoId String   @map("periodo_letivo_id") @db.Uuid
  nome            String
  /// 1EF..9EF | 1EM..3EM — validado com zod na aplicação
  serie           String
  /// regular | componente — o `classType` do OneRoster (`homeroom|scheduled`).
  /// `regular` é a turma de referência (o enturmamento); `componente` é a turma
  /// de uma disciplina/eletiva, que o mesmo estudante pode cursar em paralelo.
  tipo            String   @default("regular")
  /// manha | tarde | noite | integral — CHECK na migration
  turno           String?
  /// Código da turma na rede (`classCode`).
  codigo          String?
  fonteId         String?  @map("fonte_id")
  atualizadoEm    DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  escola        Escola        @relation(fields: [escolaId], references: [id])
  periodoLetivo PeriodoLetivo @relation(fields: [periodoLetivoId], references: [id])
  planoEnsinoConfigs PlanoDeEnsinoConfiguracao[] @relation("PlanoEnsinoTurma")
  /// Cache da matrícula principal (`users.turma_id`). A VERDADE é `matriculas`.
  estudantes    User[]
  matriculas    Matricula[]
  /// Atividades do Instanooria desta turma (`exp_01_activities.turma_id`).
  atividades    Activity[]
  /// As missões liberadas NESTA turma (ADR-69).
  liberacoes    Liberacao[]

  /// O Relógio da AULA da exp-03 mora em tabela DA EXPERIÊNCIA, não em coluna
  /// aqui: `turmas` serve a plataforma inteira, e uma coluna de cronômetro de
  /// uma missão só faria toda experiência futura herdar o vocabulário dela.
  unoogptRelogio UnoogptRelogioTurma[]
  /// O gate da aula da exp-07 mora em tabela DA EXPERIÊNCIA, pelo mesmo
  /// motivo do relógio acima.
  ecoGates       EcoGateTurma[]
  rastroGates    RastroGateTurma[]

  @@unique([escolaId, periodoLetivoId, nome])
  @@index([escolaId])
  @@map("turmas")
}

/// Enturmamento: quem está em qual turma, com que papel, desde quando
/// (≈ `enrollments` do OneRoster — a tripla usuário × turma × escola).
///
/// Três coisas que a coluna `users.turma_id` não conseguia dizer e esta tabela
/// diz: o estudante em mais de uma turma (eletiva, reforço, contraturno); o
/// PROFESSOR ligado à turma dele — vínculo que simplesmente não existia, e por
/// isso todo professor enxergava todas as turmas da escola; e o tempo, que é o
/// que permite entrar e sair no meio do ano sem apagar o passado.
///
/// `papel` aqui só admite `estudante` e `professor`: gestor é papel no NÍVEL DA
/// ESCOLA (o `roles.csv` do padrão), não matrícula de turma — e é por isso que
/// ele continua enxergando a escola inteira.
model Matricula {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId     String    @map("escola_id")
  turmaId      String    @map("turma_id") @db.Uuid
  usuarioId    String    @map("usuario_id") @db.Uuid
  /// estudante | professor — CHECK na migration
  papel        String
  /// A turma de referência da pessoa. É ela que alimenta o cache
  /// `users.turma_id` e, por ele, o claim `turma_id` do token.
  principal    Boolean   @default(false)
  inicio       DateTime  @db.Date
  /// Preenchido em vez de DELETE quando a pessoa sai: há dado de estudante pendurado
  /// em oito tabelas, e apagar a matrícula tornaria esse dado órfão de turma.
  fim          DateTime? @db.Date
  fonteId      String?   @map("fonte_id")
  atualizadoEm DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  turma   Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  usuario User  @relation("MatriculaUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([escolaId, turmaId, usuarioId, papel])
  @@index([escolaId, usuarioId])
  @@index([escolaId, turmaId])
  @@map("matriculas")
}

/// A missão DENTRO da turma — a camada que faltava entre `turmas` e
/// `experiencias` (ADR-69).
///
/// Sem linha aqui, a experiência não abre para o estudante daquela turma: é a
/// tabela que responde "esta missão está nesta sala?". Não confundir com o
/// relógio da exp-03 nem com os gates da exp-07, que respondem "a aula já
/// começou" — aqueles são DA experiência e continuam onde estão. Esta é a
/// pré-condição de todos eles.
///
/// Tabela de PLATAFORMA (sem prefixo `exp_NN_`): serve a todas as experiências,
/// e é contrato entre a plataforma e cada uma delas.
model Liberacao {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId String @map("escola_id")
  turmaId  String @map("turma_id") @db.Uuid

  /// O slug da experiência. **Sem FK para `experiencias`**, pelo mesmo motivo de
  /// `progresso.exp_id`: aquele catálogo é escrito pelo CI ao publicar o bundle,
  /// e em dev (ou num ambiente novo, antes do primeiro publish) ele está VAZIO.
  /// Uma FK faria a liberação depender de um deploy que não aconteceu.
  expId String @map("exp_id")

  /// liberada | encerrada — CHECK na migration.
  /// Não existe estado "bloqueada": a AUSÊNCIA de linha é o bloqueio. Guardar
  /// bloqueio como linha exigiria criar uma por turma × experiência para o
  /// mundo nascer fechado, e o mundo nasce fechado de graça.
  estado String @default("liberada")

  /// Quem liberou. É a pergunta que a sala faz quando a missão aparece sem
  /// ninguém saber por quê — e some do painel se virar `SET NULL`.
  liberadaPor String @map("liberada_por") @db.Uuid

  liberadaEm   DateTime  @default(now()) @map("liberada_em") @db.Timestamptz(6)
  encerradaEm  DateTime? @map("encerrada_em") @db.Timestamptz(6)
  atualizadoEm DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  turma     Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  professor User  @relation("LiberacaoProfessor", fields: [liberadaPor], references: [id])

  @@unique([escolaId, turmaId, expId])
  @@index([escolaId, turmaId])
  @@map("liberacoes")
}

/// estudante | professor | gestor | admin-contrato
/// CHECK na migration: escola_id NOT NULL exceto para `gestor_contrato`, `admin`
/// (que enxergam a rede inteira) e `gestor_regional` (cuja escola ativa é
/// escolhida por sessão entre as da regional dele — não há lotação a cachear).
model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// estudante | professor | gestor_escola | gestor_regional | gestor_contrato
  /// | admin — CHECK na migration, e o MESMO vocabulário de `PERFIS`
  /// (`auth/claims.ts`) e do claim `perfil` do token. Foram quatro até a ADR-80.
  role             String
  escolaId         String?   @map("escola_id")
  /// A REGIONAL que um `gestor_regional` cobre — e SÓ ele (CHECK bicondicional
  /// na migration). É daqui que sai a lista de escolas que ele pode ativar, no
  /// lugar da lotação; ele continua trabalhando UMA escola por vez, e a RLS não
  /// muda. Coluna, e não lotação apontando para a linha da regional, porque a
  /// ADR-79 proibiu isso: a regional apareceria no seletor do cabeçalho como
  /// uma escola sem turma, sem estudante e sem dado (ADR-80).
  regionalId       String?   @map("regional_id")
  turmaId          String?   @map("turma_id") @db.Uuid
  username         String
  displayName      String    @map("display_name")
  passwordHash     String    @map("password_hash")
  avatar           String?
  /// Identificador da PESSOA na rede (RA/matrícula). É a chave de reconciliação
  /// da importação: com ela, corrigir nome ou login continua sendo a mesma
  /// pessoa; sem ela, o upsert cai no `username` e um login corrigido vira um
  /// segundo estudante com o histórico preso no primeiro.
  /// Índice único parcial por escola vive na migration (o Prisma não modela
  /// índice parcial, e NULL não pode colidir).
  matriculaExterna String?   @map("matricula_externa")
  /// Os 11 dígitos, sem pontuação. É a identidade IMUTÁVEL da pessoa na rede:
  /// sobrevive a troca de nome, de login, de matrícula e de ESCOLA, e é por ele
  /// que uma transferência é reconhecida como a mesma criança em vez de virar
  /// uma segunda pessoa. Único por CONTRATO (não por escola) — índice parcial na
  /// migration, com CHECK de 11 dígitos.
  ///
  /// O gestor VÊ o número (ADR-33): ele confere identidade contra o sistema da
  /// rede e atende a família no balcão. O que não acontece: nunca em log, em
  /// telemetria, em JSONB, em claim de token nem em bundle de experiência — e
  /// não existe fora desta coluna, com teste estrutural cobrando.
  cpf              String?
  /// `sourcedId` desta pessoa no sistema de origem (OneRoster). Distinto do
  /// `sub` do IdP: SIS e IdP são sistemas diferentes e as duas reconciliações
  /// não são a mesma.
  fonteId          String?   @map("fonte_id")
  email            String?
  /// Saiu da rede ⇒ `false`. Nunca DELETE: dado de estudante pendurado.
  ativo            Boolean   @default(true)
  /// Senha veio da importação e ainda não foi trocada pela pessoa. Enquanto
  /// verdadeiro, o hub prende em /trocar-senha e não emite token de experiência.
  senhaProvisoria  Boolean   @default(false) @map("senha_provisoria")
  senhaDefinidaEm  DateTime? @map("senha_definida_em") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  atualizadoEm     DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  /// Cache da LOTAÇÃO principal — a escola que o token carrega quando a pessoa
  /// entra sem escolher. A verdade é `lotacoes`; esta coluna existe porque o
  /// login a lê antes de haver escola no contexto, e porque os 31 lugares que
  /// filtram por `escola_id` continuam valendo sem mudança nenhuma.
  escola            Escola?          @relation(fields: [escolaId], references: [id])
  /// Cache da matrícula principal — a verdade é `matriculas`. Continua existindo
  /// porque o login e o claim `turma_id` do token (contrato congelado) o leem
  /// fora de contexto de tenancy, onde `matriculas` (com RLS) não é alcançável.
  turma             Turma?           @relation(fields: [turmaId], references: [id])
  matriculas        Matricula[]      @relation("MatriculaUsuario")
  /// As escolas da pessoa. Professor tem mais de uma; estudante, uma ativa.
  lotacoes          Lotacao[]        @relation("LotacaoUsuario")
  /// Perfis vindos de outra instalação — nunca misturados ao dado local.
  perfisPortateis   PerfilPortatil[] @relation("PerfilPortatilEstudante")
  perfisQueImportou PerfilPortatil[] @relation("PerfilPortatilImportador")
  /// As missões que este professor liberou (ADR-69).
  liberacoesQueFez  Liberacao[]      @relation("LiberacaoProfessor")

  activities       Activity[]        @relation("ActivityProfessor")
  runs             Run[]
  perfis           PerfilImportado[]
  unootube         UnootubeSessao[]
  planos           PlanoDeAula[]     @relation("PlanoProfessor")
  planoEnsinoConfigs PlanoDeEnsinoConfiguracao[] @relation("PlanoEnsinoProfessor")
  planosDeEnsino     PlanoDeEnsinoAnual[]        @relation("PlanoEnsinoAnualProfessor")
  planosDePeriodo    PlanoDeEnsinoPeriodo[]      @relation("PlanoEnsinoPeriodoProfessor")
  regional         Escola?           @relation("RegionalDoGestor", fields: [regionalId], references: [id])
  vilaSessoes      VilaSessao[]      @relation("VilaEstudante")
  vilaPerfis       VilaPerfil[]      @relation("VilaPerfilEstudante")
  /// Lista, não `VilaBolha?`: a PK é composta (`escola_id, estudante_id`), então
  /// `estudante_id` sozinho não é único e o Prisma recusa um-para-um. É a mesma
  /// forma de `unootube` acima, que também é uma linha por estudante.
  vilaBolhas       VilaBolha[]       @relation("VilaBolhaEstudante")
  bemEstarCiclos   BemEstarCiclo[]   @relation("BemEstarCicloProfessor")
  bemEstarCheckins BemEstarCheckin[] @relation("BemEstarCheckinProfessor")
  /// Lista pelo mesmo motivo de `unootube`: PK composta não é única por estudante.
  unoogptSessoes   UnoogptSessao[]   @relation("UnoogptEstudante")
  /// Lista pelo mesmo motivo de `unootube`: PK composta não é única por estudante.
  ecoSessoes       EcoSessao[]       @relation("EcoEstudante")
  /// Lista pelo mesmo motivo de `unootube`: PK composta não é única por estudante.
  rastroSessoes    RastroSessao[]    @relation("RastroEstudante")
  /// O que esta conta ligou ou desligou no painel da Unooria (ADR-87). FK de
  /// verdade, pela mesma razão de `liberacoes.liberada_por`: "quem desligou o
  /// jogo da rede?" é a pergunta que se faz às 8h da manhã, e ela some do
  /// painel se o vínculo virar texto solto.
  disponibilidadesQueDefiniu Disponibilidade[] @relation("DisponibilidadeAutor")

  @@unique([escolaId, username])
  @@index([escolaId, role])
  @@map("users")
}

model Activity {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId          String   @map("escola_id")
  professorId       String   @map("professor_id") @db.Uuid
  /// A turma para a qual esta atividade é. NULL = atividade anterior à migration
  /// `20260830090000_atividade_por_turma`, que segue valendo para a escola
  /// inteira — o comportamento de antes. Com turma, o painel de perfis, a
  /// importação da Vila e a entrada do estudante em `POST /runs` falam todos da
  /// MESMA sala.
  turmaId           String?  @map("turma_id") @db.Uuid
  titulo            String
  disciplina        String
  temaGeral         String   @map("tema_geral")
  recorte           String
  contextoAula      String?  @map("contexto_aula")
  /// gerada pela IA a partir do tema, validada pelo professor
  perguntaChave     String   @map("pergunta_chave")
  /// ia | professor — 'professor' quando editada ou escrita à mão
  perguntaOrigem    String   @default("ia") @map("pergunta_origem")
  /// investigacao | conclusao | debate | explicabilidade | perdidos | reflexao | fim
  /// Relógio COLETIVO da turma: os momentos de turma são abertos e fechados pelo
  /// professor, e a tela do estudante trava conforme esta etapa.
  etapa             String   @default("investigacao")
  /// Personas reagem ao vivo ao que o estudante publica e comenta. Desligável pelo
  /// professor no meio da aula, sem deploy.
  iaAoVivo          Boolean  @default(true) @map("ia_ao_vivo")
  /// destilação APROVADA pelo professor: {equilibrio, ladoA{...}, ladoB{...}}
  antagonismo       Json?
  /// categorias dos neutros FORA do tema
  categoriasNeutras String[] @default([]) @map("categorias_neutras")
  /// rótulos dos neutros DENTRO do tema (fato/cronologia/fontes)
  neutrosNoTema     String[] @default([]) @map("neutros_no_tema")
  estiloVisual      String   @map("estilo_visual")
  /// posts que carregam o antagonismo; divisível por 8 (2 lados × 4 perfis)
  qtdPostsTese      Int      @default(400) @map("qtd_posts_tese")
  /// {int:{i1,i2,i3}, neutros:{ativo,modo,proporcao}}
  proporcoes        Json
  /// pesos/mixagem do motor
  engineConfig      Json     @map("engine_config")
  /// rascunho | antagonismo | gerando | revisao | ativa | encerrada
  status            String   @default("rascunho")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  professor User              @relation("ActivityProfessor", fields: [professorId], references: [id])
  turma     Turma?            @relation(fields: [turmaId], references: [id])
  authors   Author[]
  posts     Post[]
  jobs      GenerationJob[]
  runs      Run[]
  perfis    PerfilImportado[]

  @@index([escolaId])
  @@index([turmaId])
  @@map("exp_01_activities")
}

/// personas fictícias (etapa 0 da geração)
model Author {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId    String  @map("escola_id")
  activityId  String  @map("activity_id") @db.Uuid
  handle      String
  displayName String  @map("display_name")
  /// pagina_tema | fofoca_tema | checagem | humor | vida_escolar
  tipo        String
  /// A | B | neutro
  lado        String
  /// perfil de Schwartz cuja linguagem esta persona fala; null em legado
  perfilAfim  String? @map("perfil_afim")
  verificado  Boolean @default(false)
  bio         String?
  /// estilo de escrita usado nos prompts de lote
  voz         String?

  activity Activity      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  posts    Post[]
  comments PostComment[]

  @@unique([activityId, handle])
  @@index([escolaId])
  @@map("exp_01_authors")
}

model Post {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId       String   @map("escola_id")
  activityId     String   @map("activity_id") @db.Uuid
  authorId       String   @map("author_id") @db.Uuid
