model Event {
  id        BigInt   @id @default(autoincrement())
  escolaId  String   @map("escola_id")
  runId     String   @map("run_id") @db.Uuid
  postId    String?  @map("post_id") @db.Uuid
  /// visto|curtiu|descurtiu|salvou|abriu_comentarios|comentou|compartilhou|
  /// seguiu|deixou_seguir|nao_interessa|denunciou|enquete|rever|abriu_perfil
  tipo      String
  /// {dwellMs,dwellNorm} | {texto} | {opcao} | {authorId} ...
  payload   Json?
  clientTs  BigInt   @map("client_ts")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  run  Run   @relation(fields: [runId], references: [id], onDelete: Cascade)
  post Post? @relation(fields: [postId], references: [id])

  @@index([runId, id], map: "idx_exp_01_events_run")
  @@index([escolaId])
  @@map("exp_01_events")
}

/// post publicado pelo estudante (opcional, espontâneo)
model StudentPost {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId     String   @map("escola_id")
  runId        String   @map("run_id") @db.Uuid
  texto        String
  template     String
  /// lado dominante no momento da publicação
