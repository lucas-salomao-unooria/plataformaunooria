  activityId String   @map("activity_id") @db.Uuid
  /// personas | posts_lote | imagem | validacao
  tipo       String
  /// ex.: mix do lote / post_id da imagem
  payload    Json?
  /// pendente | rodando | ok | erro
  status     String   @default("pendente")
  tentativa  Int      @default(0) @db.SmallInt
  erro       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([escolaId])
  @@map("exp08ef1b_generation_jobs")
}

/// sessão de uso do estudante
model Run {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId     String    @map("escola_id")
  activityId   String    @map("activity_id") @db.Uuid
  estudanteId  String    @map("estudante_id") @db.Uuid
  /// onboarding | feed | encerramento | conclusao | revelacao | dossie | comparacao
  fase         String    @default("onboarding")
  /// A | B — vem da afinidade do perfil; nunca muda
  ladoInicial  String    @map("lado_inicial")
  /// perfil | sorteio | redistribuido — auditoria de por que caiu neste lado
  ladoOrigem   String    @default("sorteio") @map("lado_origem")
  /// PerfilDeValores do Ato 1, congelado na criação da run
  perfilJogo   Json?     @map("perfil_jogo")
  /// jogo | professor | ausente
  perfilOrigem String    @default("ausente") @map("perfil_origem")
  /// EngineState do motor
  engineState  Json      @map("engine_state")
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(6)

  /// Nome que o estudante digitou no aparelho, e o avatar que escolheu. Ficam na
  /// run porque a conta é do APARELHO: outra turma reusa o mesmo login.
  nomeNoApp       String? @map("nome_no_app")
  avatarEscolhido String? @map("avatar_escolhido")

  activity     Activity             @relation(fields: [activityId], references: [id])
  estudante    User                 @relation(fields: [estudanteId], references: [id])
  events       Event[]
  studentPosts StudentPost[]
  conclusao    Conclusao?
  reflexao     Reflexao?
  comentarios  ComentarioDaSessao[]
  dossier      Dossier?

  @@unique([activityId, estudanteId])
  @@index([escolaId])
  @@map("exp08ef1b_runs")
}

model Event {
  id        BigInt   @id @default(autoincrement())
  escolaId  String   @map("escola_id")
  runId     String   @map("run_id") @db.Uuid
  postId    String?  @map("post_id") @db.Uuid
  /// visto|curtiu|descurtiu|salvou|abriu_comentarios|comentou|compartilhou|
  /// seguiu|deixou_seguir|nao_interessa|denunciou|enquete|rever|abriu_perfil
  tipo      String
  /// {dwellMs,dwellNorm} | {texto} | {opcao} | {authorId} ...
  payload   Json?
  clientTs  BigInt   @map("client_ts")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  run  Run   @relation(fields: [runId], references: [id], onDelete: Cascade)
  post Post? @relation(fields: [postId], references: [id])

  @@index([runId, id], map: "idx_exp08ef1b_events_run")
  @@index([escolaId])
  @@map("exp08ef1b_events")
}

/// post publicado pelo estudante (opcional, espontâneo)
model StudentPost {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId     String   @map("escola_id")
  runId        String   @map("run_id") @db.Uuid
  texto        String
  template     String
  /// lado dominante no momento da publicação
  ladoInferido String   @map("lado_inferido")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  run                 Run                  @relation(fields: [runId], references: [id], onDelete: Cascade)
  comentariosDaSessao ComentarioDaSessao[]

  @@index([escolaId])
  @@map("exp08ef1b_student_posts")
}

/// perfil do Ato 1 importado ANTES de existir run
model PerfilImportado {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId         String   @map("escola_id")
  activityId       String   @map("activity_id") @db.Uuid
  estudanteId      String   @map("estudante_id") @db.Uuid
  /// {abertura,autotranscendencia,autopromocao,conservacao} normalizados 0–1
  escores          Json
  /// abertura | autotranscendencia | autopromocao | conservacao | misto
  dominante        String
  /// jogo | professor
  origem           String
  /// A | B quando o professor redistribuiu a turma; null = segue a afinidade
  ladoForcado      String?  @map("lado_forcado")
  /// A partida da Vila de onde este perfil saiu. SEM relação Prisma e sem FK:
  /// zerar a turma na Vila apaga sessões, e uma cascata (ou um RESTRICT) levaria
  /// junto o perfil que está decidindo o lado de uma aula em andamento. É rastro
  /// da medida, não integridade — id que não resolve mais é a verdade do caso.
  /// `null` = não veio da Vila desta instalação (preenchido à mão pelo professor,
  /// ou pela rota de compatibilidade `POST /perfis/importar`).
  vilaSessaoId     String?  @map("vila_sessao_id") @db.Uuid
  /// A `VERSAO_MAPEAMENTO` sob a qual o perfil foi medido. É o que permite a tela
  /// dizer "o mapeamento mudou desde esta importação" — sem ela, subir a
  /// constante deixava as cópias velhas em silêncio.
  versaoMapeamento Int?     @map("versao_mapeamento") @db.SmallInt
  medidoEm         DateTime @map("medido_em") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  activity  Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  estudante User     @relation(fields: [estudanteId], references: [id])

  @@unique([activityId, estudanteId])
  @@index([escolaId])
  @@map("exp08ef1b_app_70_perfis_importados")
}

/// conclusão da missão: neste fluxo o estudante só escolhe um lado; o texto livre
/// virou a reflexão do fim, e é sobre a atividade, não sobre a pergunta.
model Conclusao {
  runId             String   @id @map("run_id") @db.Uuid
  escolaId          String   @map("escola_id")
  /// A | B | duvida — a ÚLTIMA escolha, que é a que vale.
  inclinacao        String
  /// A PRIMEIRA escolha, imutável depois de gravada.
  ///
  /// A tela diz "pode trocar de ideia enquanto espera — vale a última", e o
  /// estudante troca de propósito. O upsert sobrescrevia `inclinacao` e a primeira
  /// se perdia para sempre: a correlação "lado do feed × resposta", que é o dado
  /// mais forte do produto, não tinha como dizer se estava lendo a reação ao
  /// feed ou o que sobrou depois de dois minutos esperando a turma.
  inclinacaoInicial String?  @map("inclinacao_inicial")
  /// Quantas vezes ele mudou de ideia antes de o professor encerrar o momento.
  trocas            Int      @default(0)
  texto             String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// `createdAt` congelava no primeiro envio e passava a mentir sobre a linha.
  atualizadoEm      DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([escolaId])
  @@map("exp08ef1b_conclusoes")
}

model Dossier {
  runId     String   @id @map("run_id") @db.Uuid
  escolaId  String   @map("escola_id")
  /// DossierData
  data      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([escolaId])
  @@map("exp08ef1b_dossiers")
}

/// Fechamento da atividade: o que o estudante entendeu sobre viés, algoritmo e as
/// próprias escolhas. Sem limite de caracteres de propósito.
model Reflexao {
  runId     String   @id @map("run_id") @db.Uuid
  escolaId  String   @map("escola_id")
  texto     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([escolaId])
  @@map("exp08ef1b_reflexoes")
}

/// Comentário que existe SÓ nesta sessão: escrito pelo estudante ou por uma persona
/// reagindo a ele. Não vai para `post_comments` porque os posts são da turma.
model ComentarioDaSessao {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId      String   @map("escola_id")
  runId         String   @map("run_id") @db.Uuid
  /// Ancoragem: um post do banco OU o post que o estudante publicou. Nunca os dois.
  postId        String?  @map("post_id") @db.Uuid
  studentPostId String?  @map("student_post_id") @db.Uuid
  /// NULL = o próprio estudante. Preenchido = a persona que respondeu.
  handle        String?
  /// Escrito pelo modelo. Existe para o professor distinguir na auditoria.
  deIa          Boolean  @default(false) @map("de_ia")
  texto         String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  run         Run          @relation(fields: [runId], references: [id], onDelete: Cascade)
  post        Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  studentPost StudentPost? @relation(fields: [studentPostId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt], map: "idx_comentarios_sessao_run")
  @@index([runId, postId], map: "idx_comentarios_sessao_post")
  @@index([escolaId])
  @@map("exp08ef1b_comentarios_da_sessao")
}

// ─── Tabelas do contrato SDK/monorepo (absorvidas do scaffold SQL) ───────────

/// Progresso salvo pela experiência via SDK (`progresso.salvar/carregar`).
model Progresso {
  escolaId     String   @map("escola_id")
  estudanteId  String   @map("estudante_id")
  expId        String   @map("exp_id")
  dados        Json     @default("{}")
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@id([escolaId, estudanteId, expId])
  @@map("progresso")
}

/// Estado server-side da exp04ef1b (uma linha por estudante). `salvos`
/// guarda ids do catálogo (`src/unootube/catalogo.ts`); o gabarito `factual`
/// não é persistido nem devolvido. CHECKs (cardinality(salvos) <= 3,
/// conclusão implica concluido_em) e RLS vivem na migration.
model UnootubeSessao {
  escolaId                String    @map("escola_id")
  estudanteId             String    @map("estudante_id") @db.Uuid
  salvos                  String[]  @default([])
  curtidos                String[]  @default([])
  rankingDesbloqueado     Boolean   @default(false) @map("ranking_desbloqueado")
  credibilidadeAdicionada Boolean   @default(false) @map("credibilidade_adicionada")
  concluidoEm             DateTime? @map("concluido_em") @db.Timestamptz(6)
  reinicios               Int       @default(0) @db.SmallInt
  criadoEm                DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm            DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  estudante User @relation(fields: [estudanteId], references: [id], onDelete: Cascade)

  @@id([escolaId, estudanteId])
  @@index([escolaId])
  @@map("exp04ef1b_sessoes")
}

/// Telemetria analítica (xAPI simplificado) — gravada pelo ingest do Pub/Sub.
/// Particionada por mês (`PARTITION BY RANGE (ts)`, migration
/// `20260827100000_telemetria_particionada`). As partições vivem no schema
/// `particoes` — fora do alcance do Prisma, que gerencia só `public`.
///
/// A PK é COMPOSTA porque o Postgres exige a chave de partição em todo índice
/// único. A dedupe do Pub/Sub segue correta: reentrega da mesma mensagem traz
/// o mesmo `ts`.
model TelemetriaEvento {
  eventId     String   @map("event_id") @db.Uuid
  ts          DateTime @db.Timestamptz(6)
  escolaId    String   @map("escola_id")
  estudanteId String   @map("estudante_id")
  expId       String   @map("exp_id")
  expVersion  String   @map("exp_version")
  sessaoId    String   @map("sessao_id") @db.Uuid
  verbo       String
  objeto      String
  resultado   Json?
  contexto    Json?

  @@id([eventId, ts])
  @@index([escolaId, expId, ts], map: "idx_tel_escola_exp_ts")
  @@map("telemetria_eventos")
}

/// Manifesto de versões das experiências: o hub monta a URL do bundle com
/// `versaoAtiva`; rollback = UPDATE deste campo. O CI faz upsert ao publicar.
model Experiencia {
  expId        String   @id @map("exp_id")
  nome         String
  versaoAtiva  String   @map("versao_ativa")
  series       String[] @default([])
  /// A unidade do ano a que a missão pertence (1 a 4). NULL nas transversais e
  /// nas ferramentas de professor — elas não moram numa unidade. É o que ordena
  /// a grade da sala; sem ela a ordem caía no `exp_id`, que é ordem de
  /// numeração da experiência e não do ano letivo (ADR-69).
  unidade      Int?     @db.SmallInt
  /// A QUE PRODUTO esta experiência pertence — `entre-redes`, `plano-de-aula`,
  /// `plano-de-ensino`, `bem-estar` (CHECK na migration, espelhando `PRODUTOS`
  /// de `src/recursos/catalogo.ts`). Declarado no `public/experiencia.json`.
  ///
  /// É esta coluna que faz o painel da Unooria se auto-estender: a composição
  /// produto → experiências é DERIVADA do manifesto, não uma lista mantida à
  /// mão — e lista à mão é a que ninguém atualiza quando a exp08ef4b nascer.
  ///
  /// NULO é dado real (linha de antes da coluna): a experiência responde só
  /// pelo próprio interruptor, sem teto de produto. Quem impede uma experiência
  /// NOVA de nascer assim é `tests/manifestos-declaram-produto.spec.ts`.
  produto      String?
  capabilities String[] @default([])
  /// {largura, altura} px lógicos quando a experiência exige casca de aparelho
  viewport     Json?
  /// estudante | professor — CHECK na migration. Ferramenta de professor (app-90)
  /// não é embedada em /exp/* nem listada para estudante.
  publico      String   @default("estudante")
  /// Permissões de iframe que esta experiência precisa. Hoje só
  /// `pointer-lock`, que liga o token `allow-pointer-lock` do sandbox do
  /// `ExpFrame` — jogo 3D em primeira pessoa (app-70). Vazio = nenhuma, que é
  /// o que toda experiência tinha antes disto existir.
  ///
  /// `fullscreen` NÃO entra aqui: o `allow` do frame já o delega a todas as
  /// experiências. Campo de manifesto que não muda nada é pior que campo
  /// nenhum — quem lê acredita que declarou algo. CHECK na migration.
  permissoes   String[] @default([])
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@map("experiencias")
}

/// UMA VERSÃO PUBLICADA de uma experiência — o histórico que o painel oferece
/// no rollback (ADR-87).
///
/// Guarda o `manifesto` INTEIRO, e não só o número, porque rollback de versão
/// hoje NÃO é rollback de manifesto: `publicar-manifesto.mjs --versao x.y.z`
/// manda o número antigo com o `experiencia.json` ATUAL do repositório, então
/// `viewport`, `permissoes`, `series` e `unidade` continuam os de agora. É a
/// classe de bug do iframe sem `allow-pointer-lock`: a criança entra na Vila, a
/// câmera não gira, e não há erro em lugar nenhum.
///
/// `publicadaPor` é TEXTO SEM FK (ao contrário de `Disponibilidade.definidoPor`):
/// quem publica quase sempre é o CI, cujo token tem `sub = 'ci-deploy'` — não é
/// uuid e não existe em `users`. Uma FK aqui mataria o job de ativação do
/// deploy DEPOIS de os bundles já terem subido.
///
/// Sem RLS e sem FK para `experiencias`, pelos mesmos motivos daquela tabela.
model ExperienciaVersao {
  expId        String   @map("exp_id")
  versao       String
  manifesto    Json
  publicadaEm  DateTime @default(now()) @map("publicada_em") @db.Timestamptz(6)
  publicadaPor String   @map("publicada_por")

  @@id([expId, versao])
  @@index([expId, publicadaEm(sort: Desc)])
  @@map("experiencias_versoes")
}

/// O INTERRUPTOR DA REDE (ADR-87): este recurso existe neste escopo?
///
/// TERCEIRO eixo, e o nome é próprio para não se confundir com os outros dois:
/// o catálogo (`experiencias`) diz que FORMA a experiência tem; a liberação
/// (`liberacoes`, ADR-69) diz se ela está aberta NAQUELA TURMA; esta diz se ela
/// EXISTE NESTA REDE. Disponibilidade é pré-condição de liberação.
///
/// AUSÊNCIA DE LINHA = LIGADO, o contrário de `liberacoes` e de propósito: lá a
/// ausência é o bloqueio, aqui é o mundo normal. Este interruptor é mecanismo de
/// EXCEÇÃO (não foi contratado, ou quebrou no deploy), não de liberação — nascer
/// desligado exigiria uma linha por recurso a cada contrato provisionado, e toda
/// experiência nova ficaria invisível até alguém lembrar de ligá-la.
///
/// SEM RLS, e a exceção está justificada na migration: é configuração da rede
/// (não dado de estudante), e a linha de escopo-contrato tem `escolaId` NULO por
/// desenho — uma política por `escola_id` esconderia justamente a resposta.
model Disponibilidade {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// `produto:<slug>` ou `experiencia:<expId>` — CHECK na migration espelhando
  /// `RECURSO_ID_RE` de `src/recursos/catalogo.ts`. Texto com prefixo, e não
  /// duas colunas: a chave da decisão é o par (recurso, escopo), e com duas o
  /// único abaixo teria três campos com um nulável.
  recursoId String @map("recurso_id")

  /// NULO = o CONTRATO inteiro (a stack). Preenchido = uma linha de `escolas`,
  /// que pode ser `tipo='escola'` OU `tipo='regional'` — a hierarquia já existe
  /// em `escolas.pai_id`, e o resolvedor sobe escola → regional → contrato.
  escolaId String? @map("escola_id")

  ligado Boolean

  /// Fixa a versão NESTE escopo; NULO = segue `experiencias.versao_ativa`. Só
  /// em `experiencia:*` (CHECK) — produto não tem bundle, logo não tem versão.
  versaoFixa String? @map("versao_fixa")

  /// OBRIGATÓRIO ao desligar (CHECK). "Desligado sem motivo" é o estado que
  /// ninguém sabe desfazer: meses depois não há como saber se é decisão
  /// comercial ou incidente que ninguém reverteu.
  motivo String?

  definidoPor  String   @map("definido_por") @db.Uuid
  definidoEm   DateTime @default(now()) @map("definido_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  escola Escola? @relation(fields: [escolaId], references: [id], onDelete: Cascade)
  autor  User    @relation("DisponibilidadeAutor", fields: [definidoPor], references: [id])

  /// NÃO basta: no Postgres `NULL` é distinto de `NULL` num índice único, então
  /// isto deixa passar duas linhas de escopo-contrato. Quem fecha é o índice
  /// único PARCIAL da migration (`WHERE escola_id IS NULL`).
  @@unique([recursoId, escolaId])
  @@index([recursoId])
  @@map("disponibilidades")
}

/// QUEM DESLIGOU ISTO, E QUANDO? (ADR-89) — o registro APPEND-ONLY das mudanças
/// de disponibilidade e de versão.
///
/// Existe porque a linha de `disponibilidades` é SOBRESCRITA a cada mudança: o
/// estado atual ela responde, o histórico não. A ADR-87 deixou este gatilho
/// declarado, e o que o disparou foi a pergunta ser feita na TELA — por quem
/// está com a escola ao telefone, não por quem tem acesso ao Cloud Logging.
///
/// Lida por DOIS painéis: o da Unooria (quem faz) e o da rede (quem sofre). A
/// rede não escreve — ligar e desligar continua só do `admin` (ADR-88).
///
/// `UPDATE` é recusado por TRIGGER; `DELETE` continua permitido (retenção
/// futura e limpeza de suíte). Sem RLS, como `disponibilidades`.
model RecursoAuditoria {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  recursoId String  @map("recurso_id")
  /// NULO = a mudança foi no escopo do CONTRATO (a rede inteira).
  escolaId  String? @map("escola_id")

  /// `ligado` | `desligado` | `herdado` | `versao-ativada` | `versao-fixada`
  /// | `versao-soltada` | `quota-alterada` — CHECK na migration, espelhando o
  /// código.
  acao String

  /// A versão, e SÓ nas duas ações que a carregam (CHECK bicondicional). Campo
  /// preenchido onde não significa nada faz quem lê a linha `desligado`
  /// concluir que a versão foi parte da decisão.
  versao String?

  motivo String?

  /// `{ de, para }` — e SÓ em `quota-alterada` (CHECK bicondicional, ADR-105),
  /// pela mesma razão de `versao`: campo preenchido onde não significa nada
  /// faz quem lê a linha procurar um número que não existiu.
  detalhe Json?

  /// SEM FK para `users`: uma FK com `RESTRICT` travaria para sempre a exclusão
  /// de quem já mexeu no painel, porque histórico não se apaga.
  autorId String @map("autor_id") @db.Uuid

  /// O nome de quem fez, CONGELADO na linha. Um JOIN mostraria o nome de hoje
  /// — ou nada, se a conta saiu da rede —, e o registro deixaria de dizer quem
  /// era aquela pessoa NAQUELE dia. Mesma razão de `exp08ef1b_runs.nome_no_app`.
  autorNome String @map("autor_nome")

  quando DateTime @default(now()) @db.Timestamptz(6)

  @@index([quando(sort: Desc)])
  @@index([recursoId, quando(sort: Desc)])
  @@index([escolaId, quando(sort: Desc)])
  @@map("recursos_auditoria")
}

/// Quota diária de IA por estudante — persistida (o Map em memória zera a cada
/// restart e é contornável com múltiplas instâncias).
model IaUsoDiario {
  escolaId     String @map("escola_id")
  usuarioId    String @map("usuario_id")
  /// YYYY-MM-DD
  dia          String
  tokensUsados Int    @default(0) @map("tokens_usados")

  @@id([escolaId, usuarioId, dia])
  @@map("ia_uso_diario")
}

/// Plano de aula gerado pelo professor (app-90-plano-de-aula). O CONTEÚDO fica
/// em object storage privado (`{contrato}-planos`); aqui só metadados, status
/// da geração assíncrona e os caminhos. `pendente|gerando|pronto|erro` — CHECK
/// na migration. RLS por escola_id + posse por professor_id nas queries.
model PlanoDeAula {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId        String    @map("escola_id")
  professorId     String    @map("professor_id") @db.Uuid
  /// 1EF..9EF | 1EM..3EM
  serie           String
  /// slug do catálogo (`letramento-digital`)
  disciplina      String
  titulo          String
  status          String    @default("pendente")
  tentativas      Int       @default(0) @db.SmallInt
  iniciadoEm      DateTime? @map("iniciado_em") @db.Timestamptz(6)
  erro            String?
  tokensUsados    Int       @default(0) @map("tokens_usados")
  /// `planos/{escolaId}/{id}/gerado.md` — Markdown da IA, imutável
  caminhoGeradoMd String?   @map("caminho_gerado_md")
  /// `planos/{escolaId}/{id}/atual.html` — o que o editor salvou
  caminhoHtml     String?   @map("caminho_html")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  professor User @relation("PlanoProfessor", fields: [professorId], references: [id], onDelete: Cascade)

  @@index([escolaId, professorId])
  @@map("app_90_planos")
}

/// Referências curriculares do CONTRATO (currículo da rede, material didático)
/// já extraídas para texto — o prompt do plano anual é montado daqui.
/// Catálogo global como `experiencias`: sem escola_id, FORA da RLS. Escrita só
/// pelo script de importação (`PLANOS_IMPORT_TOKEN`).
model PlanoReferencia {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  disciplina   String
  /// null = vale para todas as séries da disciplina (ex.: currículo da rede)
  serie        String?
  nome         String
  texto        String
  ordem        Int      @default(0)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@unique([disciplina, serie, nome])
  @@index([disciplina, serie])
  @@map("app_90_referencias")
}

// ─── app-70-vila-do-lume ─────────────────────────────────────────────────────
//
// Jogo 3D transversal (não pertence a nenhum ano). Duas leituras saem de uma
// partida, e elas NÃO SE TOCAM: o retrato de valores (Schwartz), derivado de
// escolhas com custo dentro do jogo, e a missão "A Noite Longa", que lê
// julgamento sobre mensagens. Um golpe que custasse fagulha faria a criança que
// caiu aparecer como menos generosa no retrato — por isso a separação é de
// medida, não de organização.
//
// NÃO EXISTE tabela de evento fino. Ela existia no app de origem e era
// redundante: `payload` guarda os eventos íntegros (é a fonte para recomputar o
// perfil quando o mapeamento mudar de versão), e o canal analítico do SDK já
// grava em `telemetria_eventos`. Duas tabelas de log seriam duas histórias de
// retenção para o mesmo dado.

/// Uma partida. Aberta pelo jogo ao entrar na vila (`POST /vila/sessoes`) e
/// fechada ao terminar. O ID é EMITIDO AQUI: no app de origem o cliente
/// escolhia a própria chave de idempotência, e duas crianças na mesma máquina
/// colidiam — a segunda partida voltava "duplicada" e desaparecia.
model VilaSessao {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId    String  @map("escola_id")
  estudanteId String  @map("estudante_id") @db.Uuid
  /// Turma NO MOMENTO DA PARTIDA, desnormalizada: o estudante troca de turma entre
  /// anos letivos, e o resultado precisa continuar na turma em que foi medido.
  turmaId     String? @map("turma_id") @db.Uuid

  /// versão do bundle que jogou (o hub sempre serve a `versaoAtiva`, mas quem
  /// estava com a aba aberta durante um publish termina com a anterior)
  expVersion    String @map("exp_version")
  /// versão do contrato de payload (`v` do corpo)
  schemaVersion Int    @map("schema_version") @db.SmallInt

  /// A | B | C — o nível do golpe da batida 3. Atribuída pela api (nunca pelo
  /// cliente) e copiada aqui porque o relatório abre pelo NÍVEL, antes do que
  /// ela fez: "caiu em 2 de 3" sem dizer que era o nível C faz o professor
  /// concluir que a criança é ingênua.
  bolha           String
  /// Quantos cartões a api chegou a servir. Zero ⇒ a missão não aconteceu, e o
  /// relatório precisa dizer isso em vez de "ela ignorou tudo" — é a mesma
  /// distinção entre `zero` e `none` que sustenta o perfil.
  cartoesServidos Int    @default(0) @map("cartoes_servidos") @db.SmallInt

  /// cravado pelo SERVIDOR. O app de origem derivava do relógio do cliente, e
  /// documentava que a hora numa máquina de escola costuma estar errada.
  abertaEm        DateTime  @default(now()) @map("aberta_em") @db.Timestamptz(6)
  concluidaEm     DateTime? @map("concluida_em") @db.Timestamptz(6)
  /// do "ENTRAR NA VILA" ao fim — é o tempo de JOGO, denominador dos ritmos
  duracaoSeg      Int?      @map("duracao_seg")
  /// desde que a página abriu, incluindo os cartões da intro
  duracaoTotalSeg Int?      @map("duracao_total_seg")
  /// aberta | completa | abandonada. `aberta` que nunca fecha é partida perdida
  /// (aba fechada no meio) — e saber quantas são é um dado sobre o JOGO.
  status          String    @default("aberta")

  /// Resumo tipado: o que o painel consulta e ordena. O detalhe fica no payload.
  fogueirasAcesas   Int @default(0) @map("fogueiras_acesas") @db.SmallInt
  pedrasQuebradas   Int @default(0) @map("pedras_quebradas") @db.SmallInt
  aldeoesAjudados   Int @default(0) @map("aldeoes_ajudados") @db.SmallInt
  lampioesAcesos    Int @default(0) @map("lampioes_acesos") @db.SmallInt
  tochasAcesas      Int @default(0) @map("tochas_acesas") @db.SmallInt
  dilemasVistos     Int @default(0) @map("dilemas_vistos") @db.SmallInt
  dilemasResolvidos Int @default(0) @map("dilemas_resolvidos") @db.SmallInt
  distanciaM        Int @default(0) @map("distancia_m")

  /// O corpo bruto que o jogo enviou, íntegro. Único caminho para recomputar o
  /// perfil quando `versaoMapeamento` subir. NULO depois da purga (90 dias):
  /// a linha, os contadores, o perfil e a leitura das mensagens sobrevivem; o
  /// bruto não. Consequência aceita: passado o prazo, não há reprocessamento.
  payload Json?

  /// A leitura da missão "A Noite Longa", persistida junto do perfil. No app de
  /// origem ela era derivada do bruto na hora de desenhar a tela; gravada, o
  /// relatório sobrevive a qualquer expurgo futuro do `payload` e não precisa
  /// recomputar a leitura a cada visita.
  leituraMensagens Json? @map("leitura_mensagens")

  /// SEM PRAZO DECLARADO, por decisão de 2026-08-26. Houve um `expires_at` de 90
  /// dias aqui, e nenhuma rotina que o cumprisse — coluna de prazo que ninguém lê
  /// é pior que prazo nenhum, porque quem lê o schema acredita nela (é a mesma
  /// armadilha do `turmas.consentimento_em` no app de origem).
  ///
  /// O que se ganha com isso é o REPROCESSAMENTO: `payload` é a única fonte para
  /// recomputar o perfil quando `VERSAO_MAPEAMENTO` subir, e 90 dias matavam
  /// justamente a comparação entre duas gerações do mapeamento. Se um contrato
  /// exigir prazo, ele volta COM a rotina que o cumpre.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  estudante User         @relation("VilaEstudante", fields: [estudanteId], references: [id], onDelete: Cascade)
  perfis    VilaPerfil[]

  @@index([escolaId, turmaId, abertaEm], map: "idx_app_70_sessoes_consulta")
  @@index([escolaId, estudanteId], map: "idx_app_70_sessoes_estudante")
  @@map("app_70_sessoes")
}

/// O retrato Schwartz de uma partida. RECALCULADO pelo servidor a partir das
/// medidas brutas — o jogo sabe computá-lo e deliberadamente não o envia.
///
/// O mapeamento comportamento → valor é HIPÓTESE DE DESIGN, não instrumento
/// validado (Schwartz se valida por questionário: PVQ, PBVS-C para crianças).
/// Quando a hipótese mudar, `versaoMapeamento` sobe e nasce uma linha nova; as
/// antigas ficam, porque comparar as duas é o único jeito de saber o que a
/// mudança fez.
///
/// Sem prazo, como `vila_sessoes` — ver a nota lá.
model VilaPerfil {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId    String @map("escola_id")
  sessaoId    String @map("sessao_id") @db.Uuid
  estudanteId String @map("estudante_id") @db.Uuid

  versaoMapeamento Int @map("versao_mapeamento") @db.SmallInt

  /// Os dez valores em 0–100 — e `null` NÃO É ZERO: é valor que não recebeu
  /// número, porque tem uma fonte de medida só ou porque a oportunidade não
  /// chegou até a criança.
  valores Json
  /// `scored | indicative | zero | none` por valor. A distinção mais importante
  /// do modelo: tratar "não teve chance" como "escolheu não" faz uma criança
  /// parecer ter recusado algo que nunca lhe foi oferecido.
  graus   Json

  /// Eixos do circumplexo. NULO quando um dos polos não foi observado — eixo
  /// com polo não observado não é zero, é indefinido.
  aberturaVsConservacao        Float? @map("abertura_vs_conservacao")
  transcendenciaVsAutopromocao Float? @map("transcendencia_vs_autopromocao")

  /// Falso ⇒ o painel abre avisando que não sabe. Não é rigor estatístico: é
  /// impedir que uma partida sem escolha vire uma frase sobre quem a criança é.
  amostraSuficiente Boolean @map("amostra_suficiente")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sessao    VilaSessao @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  estudante User       @relation("VilaPerfilEstudante", fields: [estudanteId], references: [id], onDelete: Cascade)

  @@unique([sessaoId, versaoMapeamento])
  @@index([escolaId, estudanteId, createdAt], map: "idx_app_70_perfis_consulta")
  @@map("app_70_perfis")
}

/// Que bolha cada estudante recebeu. Uma linha por estudante, POR ESTUDANTE e não por
/// partida, porque repetir a partida não pode trocar o nível: a folha do
/// professor diz "esse estava na C", e o relatório abre pelo nível.
///
/// A atribuição é balanceada DENTRO DA TURMA. O app de origem fazia
/// `nº do estudante mod 3`, que dava terços de graça porque os números eram
/// contíguos de 1 a 40. Hash de uuid dá terços na média da rede e pode dar
/// 14/6/5 numa sala de 25 — e aí o debate da missão não acontece, porque ele
/// depende de as três bolhas estarem na mesma sala.
model VilaBolha {
  escolaId    String   @map("escola_id")
  estudanteId String   @map("estudante_id") @db.Uuid
  /// A | B | C
  bolha       String
  atribuidaEm DateTime @default(now()) @map("atribuida_em") @db.Timestamptz(6)

  estudante User @relation("VilaBolhaEstudante", fields: [estudanteId], references: [id], onDelete: Cascade)

  @@id([escolaId, estudanteId])
  @@index([escolaId], map: "idx_app_70_bolhas_escola")
  @@map("app_70_bolhas")
}

/// Check-in de bem-estar do PROFESSOR (app-91-bem-estar): um ciclo cobre os
/// 21 itens do DASS-21 em 7 check-ins de 3 itens. `ordem_itens` é a permutação
/// dos itens 1..21 sorteada na abertura do ciclo (cada check-in = 3 itens, um
/// de cada subescala). A pontuação (soma ×2, faixas de Lovibond & Lovibond) é
/// calculada SERVER-SIDE ao fechar o 7º check-in (regra 3). Dado SENSÍVEL de
/// saúde (LGPD art. 11): só o próprio professor lê; RLS por escola_id + posse.
/// `aberto|concluido|expirado` — CHECK na migration.
model BemEstarCiclo {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId    String    @map("escola_id")
  professorId String    @map("professor_id") @db.Uuid
  status      String    @default("aberto")
  ordemItens  Int[]     @map("ordem_itens")
  iniciadoEm  DateTime  @default(now()) @map("iniciado_em") @db.Timestamptz(6)
  expiraEm    DateTime  @map("expira_em") @db.Timestamptz(6)
  concluidoEm DateTime? @map("concluido_em") @db.Timestamptz(6)
  /// Pontuações já ×2 (escala do DASS-42), preenchidas ao concluir.
  depressao   Int?
  ansiedade   Int?
  estresse    Int?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  professor User              @relation("BemEstarCicloProfessor", fields: [professorId], references: [id], onDelete: Cascade)
  checkins  BemEstarCheckin[]

  @@index([escolaId, professorId, status])
  @@map("app_91_ciclos")
}

/// Um check-in (≤ 1 por dia por professor — `dia` é YYYY-MM-DD no fuso do
/// contrato). Nasce `pendente` no GET /bemestar/hoje, já com os 3 itens e os
/// textos da IA (abertura + pergunta aberta) que o professor viu; vira
/// `respondido` no POST. `respostas` = [{ item, valor }] ×3 (valor 0..3).
/// `origem_texto`: `ia` | `fallback` (IA indisponível ou barrada pelo
/// guardrail) | `seguranca` (sinal de apoio — texto fixo, a IA nem é chamada).
model BemEstarCheckin {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId     String    @map("escola_id")
  professorId  String    @map("professor_id") @db.Uuid
  cicloId      String    @map("ciclo_id") @db.Uuid
  /// 1..7 dentro do ciclo
  numero       Int       @db.SmallInt
  dia          String
  status       String    @default("pendente")
  itens        Int[]
  respostas    Json?
  textoLivre   String?   @map("texto_livre")
  abertura     String
  pergunta     String
  acolhimento  String?
  origemTexto  String    @default("fallback") @map("origem_texto")
  sinalDeApoio Boolean   @default(false) @map("sinal_de_apoio")
  tokensIa     Int       @default(0) @map("tokens_ia")
  respondidoEm DateTime? @map("respondido_em") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  professor User          @relation("BemEstarCheckinProfessor", fields: [professorId], references: [id], onDelete: Cascade)
  ciclo     BemEstarCiclo @relation(fields: [cicloId], references: [id], onDelete: Cascade)

  @@unique([escolaId, professorId, dia])
  @@index([cicloId])
  @@map("app_91_checkins")
}

// ---------------------------------------------------------------------------
// exp02em1b — a Missão Tempestade (Serra do Sauá)
//
// Porte do projeto `gpturia`. Cinco tabelas, e NENHUMA coluna de prazo: houve
// um `expires_at` de 30 dias no origem com uma rota de cron para cumpri-lo;
// aqui não há job agendado, de propósito, e prazo que nenhuma rotina cumpre é
// pior que prazo nenhum — quem lê o schema acredita nele. O caminho de
// exclusão que existe de fato é "zerar a turma" (precedente da app-70).
//
// Cinco colunas do origem NÃO vieram porque estavam mortas lá: `evidencias`
// (só escrita), `camadas_reveladas` e `pergunta_id` (só escritas vazias),
// `simulacoes_restantes` e `custo_cents` (zero leituras). Centavo virou token:
// preço depende de tabela do vendor, token é o que o provider devolve.
//
// A sessão NÃO tem id próprio: a identidade é `(escola_id, estudante_id)`, vinda do
// token, e os filhos apontam para o par. Foi o que dispensou a guarda
// `donoDaSessao` do origem, onde a sessão era identificada por uuid na URL.
// CHECKs e RLS vivem na migration.
// ---------------------------------------------------------------------------

/// Estado server-side de uma partida (uma linha por estudante, como a exp04ef1b).
model UnoogptSessao {
  escolaId    String  @map("escola_id")
  estudanteId String  @map("estudante_id") @db.Uuid
  /// Denormalizado da identidade: o painel do professor consulta por turma o
  /// tempo todo, e resolver isso por join a cada leitura era o caminho para
  /// esquecer o filtro em alguma consulta nova.
  turmaId     String? @map("turma_id") @db.Uuid

  /// abertura | orientacao | investigacao | resultado (CHECK na migration).
  passo              String   @default("abertura")
  /// Qual partida do estudante. Recomeçar ABRE tentativa nova em vez de apagar a
  /// conversa: para o estudante a tela limpa, para o professor a aula continua
  /// legível.
  tentativa          Int      @default(1) @db.SmallInt
  /// Minuto NARRATIVO decorrido desde as 17h00 — snapshot do que o relógio da
  /// turma já produziu. A fonte da verdade é `exp02em1b_relogio_turma`; isto é o
  /// instante congelado da última ação, e é o minuto de SAÍDA das equipes
  /// quando a tempestade é enfrentada.
  minutosGastos      Int      @default(0) @map("minutos_gastos")
  /// Conjuntos de dados carregados no modelo. Acumulam em camadas: o mapa é a
  /// leitura DELES, com o viés deles junto.
  conjuntos          String[] @default([])
  /// Quantas vezes o modelo já rodou nesta partida. Semeia o sorteio.
  rodadas            Int      @default(0)
  /// Perguntas de investigação gastas. Conta o GASTO, não o resto: mudar o
  /// teto passa a valer para partida em curso.
  perguntasGastas    Int      @default(0) @map("perguntas_gastas")
  /// Slug do bairro de destino de cada equipe. O Cientista NÃO escolhe — ele
  /// registra a escolha do estudante.
  alocacaoAlfa       String?  @map("alocacao_alfa")
  alocacaoBravo      String?  @map("alocacao_bravo")
  /// Slug de um conjunto que o estudante carregou, ou 'intuicao'. O software não
  /// julga a resposta; quem lê é o professor.
  justificativaAlfa  String?  @map("justificativa_alfa")
  justificativaBravo String?  @map("justificativa_bravo")

  /// Teto de custo por SESSÃO (`regras/defaults.ts`). Soma voltas de
  /// ferramenta e tentativas rejeitadas — o que foi pago, não o aproveitado.
  tokensGastos Int @default(0) @map("tokens_gastos")
  chamadasIa   Int @default(0) @map("chamadas_ia")

  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  concluidoEm  DateTime? @map("concluido_em") @db.Timestamptz(6)

  estudante  User               @relation("UnoogptEstudante", fields: [estudanteId], references: [id], onDelete: Cascade)
  mensagens  UnoogptMensagem[]
  marcos     UnoogptMarco[]
  simulacoes UnoogptSimulacao[]

  @@id([escolaId, estudanteId])
  @@index([escolaId])
  @@index([escolaId, turmaId])
  @@map("exp02em1b_sessoes")
}

/// A Transcrição: a conversa entre o estudante e o Cientista.
///
/// `texto` é CAIXA LIVRE escrita por menor de idade, e é o dado mais sensível
/// da experiência. Ele existe porque o professor precisa ler a conversa no
/// relatório — é o instrumento. Nunca vai a log, nunca à telemetria, e nenhuma
/// rota de gestor o alcança (só o professor da escola).
model UnoogptMensagem {
  id          BigInt   @id @default(autoincrement())
  escolaId    String   @map("escola_id")
  estudanteId String   @map("estudante_id") @db.Uuid
  /// estudante | agente (CHECK na migration).
  papel       String
  texto       String
  /// Passo em que a fala aconteceu.
  passo       String
  /// Cartão anexado a esta fala: tendência do modelo, alocação, opções ou
  /// desfecho. Fica na Transcrição para a conversa voltar inteira depois de um
  /// F5 — da Investigação em diante tudo acontece no chat.
  anexo       Json?
  /// Se esta fala debitou uma Pergunta do orçamento.
  debitou     Boolean  @default(false)
  tentativa   Int      @default(1) @db.SmallInt
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  sessao UnoogptSessao @relation(fields: [escolaId, estudanteId], references: [escolaId, estudanteId], onDelete: Cascade)

  /// Paginação por id é estável; por timestamp não.
  @@index([escolaId, estudanteId, id])
  @@map("exp02em1b_mensagens")
}

/// A trilha da decisão: o que o estudante fez, em que minuto da cidade.
///
/// `dados` traz SÓ dado público — nada de viés, Lacuna ou parâmetro oculto:
/// este JSON chega ao navegador.
model UnoogptMarco {
  id                BigInt   @id @default(autoincrement())
  escolaId          String   @map("escola_id")
  estudanteId       String   @map("estudante_id") @db.Uuid
  tentativa         Int      @db.SmallInt
  /// Sequência dentro da tentativa.
  ordem             Int
  /// fontes | leitura | alocacao | envio | inicio | recomeco (CHECK na migration).
  tipo              String
  /// Minuto do relógio em que aconteceu: vira hora da cidade na tela.
  /// Recalculado do relógio da TURMA no instante da gravação — nunca copiado
  /// de `sessoes.minutos_gastos`, que só o turno do Cientista atualizava e
  /// atrasava até um turno inteiro nas rotas diretas (ADR-64).
  minuto            Int
  /// O cronômetro de parede que o estudante via ("faltavam 1:40"). Null = modo
  /// livre, sem relógio, ou marco anterior à coluna. Não se reconstrói depois:
  /// "+2 min" muda a duração sem histórico e "zerar" apaga o relógio.
  segundosRestantes Int?     @map("segundos_restantes")
  /// `tempo` | `professor` quando o relógio já tinha fechado no instante do
  /// marco. É o "estourou" do relatório, sem inferência.
  motivoDoFim       String?  @map("motivo_do_fim")
  dados             Json
  criadoEm          DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  sessao UnoogptSessao @relation(fields: [escolaId, estudanteId], references: [escolaId, estudanteId], onDelete: Cascade)

  @@unique([escolaId, estudanteId, tentativa, ordem])
  @@index([escolaId, estudanteId])
  @@map("exp02em1b_marcos")
}

/// O desfecho de cada tentativa — o AGREGADO, que sobrevive ao "zerar a turma"
/// do ponto de vista conceitual (é o que um relatório de rede leria) e é a
/// única fonte para comparar duas gerações do prompt.
model UnoogptSimulacao {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId      String   @map("escola_id")
  estudanteId   String   @map("estudante_id") @db.Uuid
  ordem         Int
  /// { v:1, alfa, bravo } — os slugs de destino.
  alocacao      Json
  /// { v:1, salvas, naoSalvas, porBairro, ... } vindo do motor.
  desfecho      Json
  /// Minuto da cidade em que as equipes saíram: é o que decidiu se cada uma
  /// chegou. Guardado JUNTO do desfecho para a linha ser autoexplicativa.
  minutoDaSaida Int      @map("minuto_da_saida")
  /// Versão do prompt gravada JUNTO da saída: sem isso não se sabe qual prompt
  /// produziu o que está em produção.
  versaoPrompt  Int      @map("versao_prompt")
  /// { v:1, media, faixa, vitimasMedia, vitimasFaixa, amostras, percentil } —
  /// a FAIXA da mesma decisão, gravada no confirmar. Antes era recomputada a
  /// cada leitura (200 corridas), e uma mudança de parâmetro reescrevia em
  /// silêncio o relatório de partidas antigas (ADR-64). Null = simulação
  /// anterior à coluna; a leitura recomputa.
  esperado      Json?
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  sessao UnoogptSessao @relation(fields: [escolaId, estudanteId], references: [escolaId, estudanteId], onDelete: Cascade)

  @@unique([escolaId, estudanteId, ordem])
  @@index([escolaId, estudanteId])
  @@map("exp02em1b_simulacoes")
}

/// O Relógio da AULA — por TURMA, não por estudante.
///
/// Antes o cronômetro armava sozinho quando o estudante entrava na Investigação, e
/// cada um começava quando abria o link. Numa sala isso é uma corrida com
/// largadas diferentes: quem chegou primeiro terminava antes de o professor
/// acabar de explicar. Quem dá a partida é o professor, e ela vale para todo
/// mundo ao mesmo tempo. Mesmo espírito do lock por turma da app-70.
model UnoogptRelogioTurma {
  escolaId String @map("escola_id")
  turmaId  String @map("turma_id") @db.Uuid

  /// cronometrado | livre (CHECK na migration).
  modo        String    @default("cronometrado")
  /// Null = a missão ainda não começou: o estudante vê o cronômetro parado e não
  /// consegue falar com o Cientista.
  iniciadoEm  DateTime? @map("iniciado_em") @db.Timestamptz(6)
  /// Duração em segundos de parede. "+2 min" soma 120.
  duracaoSeg  Int       @default(300) @map("duracao_seg")
  /// O professor encerrou antes da hora.
  encerradoEm DateTime? @map("encerrado_em") @db.Timestamptz(6)
  /// Pivô da extensão (`regras/relogio.ts`): onde o relógio da cidade estava
  /// quando a duração mudou. É o que impede o minuto narrativo de rebobinar —
  /// aos 4:00 de 5:00 o estudante está no minuto 48, e recalcular com 7:00 daria 34.
  pivoSeg     Int       @default(0) @map("pivo_seg")
  pivoMin     Int       @default(0) @map("pivo_min")

  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@id([escolaId, turmaId])
  @@index([escolaId])
  @@map("exp02em1b_relogio_turma")
}

// ═══════════════════════════════════════════════ exp06ef2b — o rastro do boato
//
// A missão do 6º ano: auditar os metadados de um boato em quatro grupos de
// mensagens, decidir sob contágio ativo e ler a própria decisão no mapa da
// rede. Quatro tabelas, e o desenho segue o do Eco no Grupo (retirado) — o que é 1:1 com a sessão
// é COLUNA da sessão, não tabela: `exp06ef2b_decisoes` e `exp06ef2b_modelagens` do
// PRD virariam duas linhas por estudante com uma FK cada, e o JOIN existiria
// para nada.
//
// GABARITO nenhum aqui: a ordem certa do ciclo, o desfecho de cada opção e a
// matriz de propagação moram em `src/rastro-boato/catalogo.ts` e nas regras
// puras (regra inviolável nº 3). CHECKs e RLS vivem na migration.

/// A sessão do estudante na missão. Uma por estudante e por escola.
model RastroSessao {
  escolaId    String  @map("escola_id")
  estudanteId String  @map("estudante_id") @db.Uuid
  /// Denormalizado da identidade: o painel e o gate da turma
  /// consultam por turma o tempo todo.
  turmaId     String? @map("turma_id") @db.Uuid

  /// contexto | chats | decisao | breakpoint | resultado | ciclo | percurso |
  /// fim (CHECK na migration; a ordem é `regras/passos.ts`).
  passo String @default("contexto")

  /// A | B | C (CHECK na migration). Null = ainda não decidiu.
  opcao          String?
  /// Segundos entre a crise chegar e o envio. Distingue impulso de reflexão, e
  /// é cronometrado pelo CLIENTE: a latência da api não é o dado.
  latenciaSeg    Int?    @map("latencia_seg")
  /// O alerta de inação de 90s chegou a aparecer? É `indicative` e alimenta a
  /// hipótese H3 do playtest — nunca entra no nível.
  houveInacao90s Boolean @default(false) @map("houve_inacao_90s")

  /// A sequência dos 4 blocos como o estudante a montou. Vazio = ainda não
  /// confirmou. Guardar a ordem BRUTA, e não só o booleano, é o que deixa
  /// reprocessar a leitura pedagógica numa versão futura do instrumento.
  ordemBlocos String[] @default([]) @map("ordem_blocos")
  /// A sequência descreve o ciclo? Calculado em `regras/ciclo.ts`, nunca aceito
  /// do cliente. Null = ainda não confirmou.
  coerente    Boolean? @map("coerente")

  /// 0 / 70 / 100, de `regras/pontuacao.ts`. NÃO é nota e não aparece em tela
  /// nenhuma: existe porque o `exp:concluir` da bridge tem o campo e o
  /// progresso da plataforma o lê. Null = a missão ainda não fechou.
  score Int?

  /// A versão do instrumento, gravada na linha para permitir reprocessamento
  /// histórico quando o catálogo mudar (DAD-06).
  versaoInstrumento String @default("1.0.0") @map("versao_instrumento")

  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  concluidoEm  DateTime? @map("concluido_em") @db.Timestamptz(6)

  estudante  User              @relation("RastroEstudante", fields: [estudanteId], references: [id], onDelete: Cascade)
  auditorias RastroAuditoria[]
  reflexoes  RastroReflexao[]

  @@id([escolaId, estudanteId])
  @@index([escolaId])
  @@index([escolaId, turmaId])
  @@map("exp06ef2b_sessoes")
}

/// Cada abertura do modal "Dados da mensagem".
///
/// É a evidência que a missão MEDE (EF06CO01), e é 1:N de propósito: a cota de
/// 3 é sobre mensagens DISTINTAS, e guardar só um contador perderia QUAIS o
/// estudante escolheu auditar — que é o dado pedagógico. A dedupe é do
/// servidor (`regras/auditoria.ts`), reforçada pelo UNIQUE abaixo.
model RastroAuditoria {
  id            BigInt   @id @default(autoincrement())
  escolaId      String   @map("escola_id")
  estudanteId   String   @map("estudante_id") @db.Uuid
  /// Id do catálogo (`msg-boato-01`…). Validado contra ele antes de gravar.
  mensagemId    String   @map("mensagem_id")
  chatId        String   @map("chat_id")
  /// Segundos com o modal aberto. Calibragem de fluxo, não medida de mérito.
  tempoLeituraS Int      @default(0) @map("tempo_leitura_s")
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  sessao RastroSessao @relation(fields: [escolaId, estudanteId], references: [escolaId, estudanteId], onDelete: Cascade)

  /// Reabrir o mesmo balão é releitura, não auditoria nova: o UNIQUE faz a
  /// dedupe valer mesmo se um caminho novo esquecer de checar antes.
  @@unique([escolaId, estudanteId, mensagemId])
  @@index([escolaId, estudanteId])
  @@map("exp06ef2b_auditorias")
}

/// O "Meu percurso" — a reflexão metacognitiva de até 280 caracteres.
///
/// **Texto livre escrito por menor de idade**, e o dado mais sensível daqui.
/// Nunca vai a log, nunca à telemetria analítica (o Pub/Sub leva números e
/// enums), e nenhuma rota de gestor o alcança: quem lê é o professor da turma
/// dela. LGPD art. 14 + `invariantes.ts`.
model RastroReflexao {
  escolaId    String   @map("escola_id")
  estudanteId String   @map("estudante_id") @db.Uuid
  texto       String   @db.VarChar(280)
  charsCount  Int      @map("chars_count")
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  sessao RastroSessao @relation(fields: [escolaId, estudanteId], references: [escolaId, estudanteId], onDelete: Cascade)

  @@id([escolaId, estudanteId])
  @@index([escolaId])
  @@map("exp06ef2b_reflexoes")
}

/// O GATE DA AULA — por TURMA. É o que deixa a professora conduzir 30 telas.
///
/// Duas etapas só (`regras/passos.ts`): a Aula 1 fecha num breakpoint que só
/// ela abre, e "Pausar simulação" volta. A reconciliação entre esta etapa e o
/// passo de cada estudante é função pura, porque a api e o cliente precisam
/// chegar à mesma resposta.
model RastroGateTurma {
  escolaId String @map("escola_id")
  turmaId  String @map("turma_id") @db.Uuid

  /// aula1 | aula2 (CHECK na migration).
  etapa String @default("aula1")

  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@id([escolaId, turmaId])
  @@index([escolaId])
  @@map("exp06ef2b_gates_turma")
}

// ═══════════════════════════════════════════════ app-92 — plano de ensino
//
// O planejamento dirigido pela BNCC, em dois níveis: um plano ANUAL (macro,
// prosa pedagógica por período de avaliação) e planos de PERÍODO (granular,
// aula a aula, semanal ou quinzenal). Um alimenta o outro.
//
// Por que não reaproveitou `app_90_planos`: a app-90 gera um documento a partir
// de TEXTO de currículo importado, e o que ela sabe do plano é "de que
// disciplina e série ele é". Aqui o plano precisa saber quantas aulas o
// professor tem, em que dias, em quantos períodos, e QUAIS habilidades caem em
// cada um — nada disso cabe nas colunas de lá, e alargá-las quebraria a app-90
// que está em uso.

/// A REGÊNCIA: o que este professor leciona, para quem, quantas aulas e quando.
///
/// É a entrada de tudo. Sem ela o plano anual distribui habilidades em "quatro
/// bimestres" sem saber se cabem 200 aulas de Matemática ou 40 de Arte — e a
/// diferença entre esses dois números é a diferença entre um plano executável e
/// uma lista de intenções.
///
/// O passo do planejamento granular é SEMPRE semanal. Houve uma coluna
/// `periodicidade` (semanal | quinzenal) e ela saiu na
/// `20260907120000_exp_92_planejamento_sempre_semanal` (ADR-76): a `ordem` de
/// `app_92_planos_de_periodo` mudava de significado com ela, e entregar de
/// quinze em quinze dias é recorte de exportação, não de planejamento.
model PlanoDeEnsinoConfiguracao {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId    String @map("escola_id")
  professorId String @map("professor_id") @db.Uuid

  anoLetivo  Int    @map("ano_letivo") @db.SmallInt
  /// 1EF..9EF | 1EM..3EM — validado com zod na aplicação.
  serie      String
  /// Slug de `curriculo/componentes.ts` — o componente DA REDE, não o da BNCC:
  /// `biologia` é escolha válida, e as habilidades dela vêm da área.
  componente String

  /// Opcional de propósito: em novembro o professor planeja o ano seguinte, e a
  /// turma ainda não existe. Preenchida, amarra o plano à sala real.
  turmaId String? @map("turma_id") @db.Uuid

  /// A volta às aulas DESTA regência. Vive aqui, e não só em `periodos_letivos`,
  /// porque aquela tabela é catálogo do CONTRATO e o seed a preenche como ano
  /// CIVIL (01/01–31/12): o calendário do plano alinha os períodos na segunda, e
  /// a semana de 1º de janeiro de 2026 começa em 29/12/2025 — o professor que
  /// declarava 02/02 recebia um 1º bimestre em dezembro do ano anterior.
  /// `null` = usa a sugestão do catálogo (regências criadas antes da coluna).
  inicioDoAnoLetivo DateTime? @map("inicio_do_ano_letivo") @db.Date

  /// bimestral | trimestral | semestral — CHECK na migration. Nenhuma norma
  /// nacional fixa isso: o calendário é aprovado escola a escola.
  divisaoDoAno   String @default("bimestral") @map("divisao_do_ano")
  /// 50 na maioria das redes; 45 aparece no noturno. NÃO é hora-relógio — o
  /// Parecer CNE/CEB 8/2004 proíbe tratar aula de 45min como uma hora, e é
  /// desta coluna que sai a conversão.
  minutosPorAula Int    @default(50) @map("minutos_por_aula") @db.SmallInt
  aulasSemanais  Int    @map("aulas_semanais") @db.SmallInt

  /// A grade do professor: `[{ diaDaSemana: 1..5, horarios: ["07:00","07:50"] }]`.
  /// Guardado como JSON porque é configuração de UMA linha, lida inteira e
  /// nunca consultada por dentro — normalizar em duas tabelas daria join sem
  /// nenhuma query que o justifique.
  grade Json @default("[]")

  /// Sobrepõe a camada transversal de Computação (Res. CNE/CEB 1/2022) ao
  /// componente. A articulação entre uma habilidade `CO` e uma do componente é
  /// INFERÊNCIA do produto: não existe crosswalk normativo, e a norma delega a
  /// abordagem à rede (art. 2º). A tela precisa rotular isso como sugestão.
  incluirComputacao Boolean @default(false) @map("incluir_computacao")

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  professor    User                 @relation("PlanoEnsinoProfessor", fields: [professorId], references: [id], onDelete: Cascade)
  turma        Turma?               @relation("PlanoEnsinoTurma", fields: [turmaId], references: [id], onDelete: SetNull)
  planosAnuais PlanoDeEnsinoAnual[]

  /// Um professor tem UMA configuração por ano letivo, série e componente. Duas
  /// turmas do mesmo 7º ano de Matemática compartilham o planejamento — é o que
  /// o professor faz na prática, e forçar uma cópia por turma multiplicaria o
  /// trabalho dele sem acrescentar informação.
  @@unique([escolaId, professorId, anoLetivo, serie, componente], map: "app_92_configuracao_unica")
  @@index([escolaId, professorId])
  @@map("app_92_configuracoes")
}

/// O PLANO ANUAL — o macro. Prosa pedagógica gerada pela IA sobre a distribuição
/// de habilidades que o professor decidiu, período por período.
///
/// `distribuicao` é a decisão HUMANA e fica no banco, estruturada; o documento
/// gerado é prosa e vai para o object storage, no mesmo arranjo da app-90
/// (metadado aqui, conteúdo lá). A separação importa: o professor pode reescrever
/// o texto inteiro sem que o sistema perca qual habilidade cai em que bimestre —
/// e é isso que o plano de período precisa saber para ser gerado.
model PlanoDeEnsinoAnual {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId       String @map("escola_id")
  professorId    String @map("professor_id") @db.Uuid
  configuracaoId String @map("configuracao_id") @db.Uuid

  titulo       String
  /// pendente | gerando | pronto | erro — CHECK na migration. Mesma máquina de
  /// estados da app-90: a geração corre em background e a tela faz polling.
  status       String    @default("pendente")
  tentativas   Int       @default(0) @db.SmallInt
  iniciadoEm   DateTime? @map("iniciado_em") @db.Timestamptz(6)
  erro         String?
  tokensUsados Int       @default(0) @map("tokens_usados")

  /// `{ "1": ["EF67LP08", "EF67LP09"], "2": [...] }` — habilidades por período
  /// de avaliação. A chave é a ordem do período (1 = 1º bimestre).
  distribuicao           Json @default("{}")
  /// `{ "1": ["EF07CO03"] }` — a camada transversal de Computação, separada
  /// porque é sugestão do produto e não currículo do componente.
  distribuicaoComputacao Json @default("{}") @map("distribuicao_computacao")

  /// `planos-de-ensino/{escolaId}/{id}/gerado.md` — o que a IA escreveu, imutável.
  caminhoGeradoMd String? @map("caminho_gerado_md")
  /// `planos-de-ensino/{escolaId}/{id}/atual.html` — o que o professor salvou.
  caminhoHtml     String? @map("caminho_html")

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  configuracao PlanoDeEnsinoConfiguracao @relation(fields: [configuracaoId], references: [id], onDelete: Cascade)
  professor    User                      @relation("PlanoEnsinoAnualProfessor", fields: [professorId], references: [id], onDelete: Cascade)
  periodos     PlanoDeEnsinoPeriodo[]

  @@index([escolaId, professorId])
  @@index([escolaId, configuracaoId])
  @@map("app_92_planos_anuais")
}

/// O PLANO DE PERÍODO — o granular, aula a aula, de uma semana ou quinzena.
///
/// Aqui as aulas são DADO ESTRUTURADO (`aulas`), não prosa, e essa é a diferença
/// que faz o produto valer: o professor edita a aula de quinta-feira sem mexer
/// no resto, o sistema sabe quantas aulas já foram planejadas contra quantas
/// existem no período, e o export monta a grade a partir do dado em vez de
/// pedir à IA que formate uma tabela.
///
/// Cada item de `aulas`:
/// `{ numero, data, horario, tema, objetivo, habilidades: [codigo],
///    conteudo, momentos: { retomada, desenvolvimento, sistematizacao, fechamento },
///    recursos: [], avaliacao, tarefaDeCasa, adaptacoes }`
///
/// Os quatro `momentos` não são enfeite: é o que separa um plano de aula de uma
/// lista de conteúdos. Um plano sem retomada e sem fechamento não diz ao
/// professor substituto o que fazer com os 50 minutos.
model PlanoDeEnsinoPeriodo {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId     String @map("escola_id")
  professorId  String @map("professor_id") @db.Uuid
  planoAnualId String @map("plano_anual_id") @db.Uuid

  /// 1 = primeira semana/quinzena do ano letivo. Ordena o caderno do professor.
  ordem              Int      @db.SmallInt
  inicio             DateTime @db.Date
  fim                DateTime @db.Date
  /// A qual período de avaliação esta semana pertence (1 = 1º bimestre) — é o
  /// que liga o granular ao macro e permite herdar as habilidades do anual.
  periodoDeAvaliacao Int      @map("periodo_de_avaliacao") @db.SmallInt

  status       String    @default("pendente")
  tentativas   Int       @default(0) @db.SmallInt
  iniciadoEm   DateTime? @map("iniciado_em") @db.Timestamptz(6)
  erro         String?
  tokensUsados Int       @default(0) @map("tokens_usados")

  aulas Json @default("[]")

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  planoAnual PlanoDeEnsinoAnual @relation(fields: [planoAnualId], references: [id], onDelete: Cascade)
  professor  User               @relation("PlanoEnsinoPeriodoProfessor", fields: [professorId], references: [id], onDelete: Cascade)

  @@unique([escolaId, planoAnualId, ordem], map: "app_92_periodo_unico")
  @@index([escolaId, professorId])
  @@map("app_92_planos_de_periodo")
}

// ═══════════════════════════════════════════ exp08ef4b — o manifesto da IA
//
// "O Manifesto da IA: Nossos Direitos em Código" — 8º ano, 4º bimestre. O
// estudante audita um sistema de predição escolar dentro de um clone do
// ChatGPT, derruba a tese de neutralidade da máquina e fixa uma cláusula de
// governança que ela passa a obedecer.
//
// CINCO tabelas, e o desenho segue a exp06ef2b: o que é 1:1 com a sessão é COLUNA
// da sessão, não tabela. A exceção é `exp08ef4b_auditorias`, que é 1:N de
// propósito — a cota de 2 é sobre prompts DISTINTOS, e guardar só um contador
// perderia QUAIS questionamentos a criança escolheu fazer, que é o dado
// pedagógico da Etapa 2.
//
// A tabela a mais em relação à exp06ef2b é `exp08ef4b_conteudo_turma`: o pacote
// curado que a professora homologa antes da aula (exigência 8.2 — nenhum texto
// gerado por IA chega ao estudante sem clique formal dela).
//
// GABARITO nenhum aqui, e nesta missão a ausência é mais forte que nas outras:
// **não existe resposta certa.** As quatro cláusulas são igualmente válidas sob
// governança de direitos, e a lista de métricas proibidas do handoff veda
// calcular taxa de acerto entre elas. O que o servidor guarda para si é o
// material de MEDIAÇÃO (a `justificativa_sugerida` de cada cláusula) e a
// réplica da máquina antes de a pergunta ser feita.
//
// CHECKs e RLS vivem na migration.

/// O PACOTE CURADO DA TURMA — o que a professora homologa antes da aula.
///
/// Uma linha por turma. `aprovado_por_professor` é o portão da exigência 8.2:
/// sem ele `true`, a missão do estudante lê o banco curado default da Unooria
/// (`src/manifesto-ia/catalogo.ts`) e a aula corre igual. **Nunca** o conteúdo
/// gerado por IA em rascunho — é essa a diferença entre curadoria e
/// publicação automática.
///
/// Sobrevive ao "Zerar turma": o preparo custou tempo da professora, e apagá-lo
/// junto com as respostas obrigaria a refazer a curadoria para reaplicar a
/// missão numa segunda turma no mesmo dia.
model Exp08ef4bConteudoTurma {
  escolaId String @map("escola_id")
  turmaId  String @map("turma_id") @db.Uuid

  /// O caso da escola, como a professora o descreveu no formulário.
  casoContextual  String @map("caso_contextual")
  focoPrioritario String @map("foco_prioritario")

  /// Os 3 prompts de auditoria COM as réplicas da máquina, e as 4 cláusulas COM
  /// as justificativas de mediação. `Json` e não tabelas-filhas porque o pacote
  /// é lido e escrito SEMPRE inteiro — a professora aprova o conjunto, não um
  /// prompt de cada vez —, e normalizá-lo produziria sete linhas com uma FK
  /// cada para nada. O Zod de `contrato-de-rotas.ts` é o schema real (o Prisma
  /// não valida forma de Json), e o CHECK da migration cobra a cardinalidade.
  contexto      Json @map("contexto")
  promptsJson   Json @map("prompts_json")
  clausulasJson Json @map("clausulas_json")

  /// O clique formal em "Aprovar Conteúdo da Turma". Falso = rascunho.
  aprovadoPorProfessor Boolean @default(false) @map("aprovado_por_professor")
  /// A professora manteve o pacote da Unooria em vez de gerar com IA? É o dado
  /// que diz se a curadoria assistida está sendo usada — e a resposta "não"
  /// não é problema: o banco default é homologado, não é fallback de erro.
  usouBancoDefault     Boolean @default(false) @map("usou_banco_default")

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@id([escolaId, turmaId])
  @@index([escolaId])
  @@map("exp08ef4b_conteudo_turma")
}

/// A sessão do estudante na missão. Uma por estudante e por escola.
model Exp08ef4bSessao {
  escolaId    String  @map("escola_id")
  estudanteId String  @map("estudante_id") @db.Uuid
  /// Denormalizado da identidade, como na exp06ef2b: o painel e o gate da turma
  /// consultam por turma o tempo todo.
  turmaId     String? @map("turma_id") @db.Uuid

  /// briefing | chat | decisao | manifesto | percurso | podcast | fim
  /// (CHECK na migration; a ordem é `regras/passos.ts`).
  passo String @default("briefing")

  /// A cláusula fixada na Etapa 3 — LATCH. Null = ainda não decidiu.
  clausulaId          String? @map("clausula_id")
  /// Segundos entre a concessão da máquina e a submissão. Distingue impulso de
  /// deliberação, e é cronometrado pelo CLIENTE: a latência da api não é o dado.
  latenciaClausulaSeg Int?    @map("latencia_clausula_seg")
  /// A criança clicou em menos de 5s e passou pela réplica provocativa do bot?
  /// É `indicative` e alimenta a hipótese de exploração mínima do playtest —
  /// nunca entra em avaliação de ninguém.
  confirmouProvocacao Boolean @default(false) @map("confirmou_provocacao")

  /// O documento promulgado, compilado no SERVIDOR (`regras/manifesto.ts`).
  /// Gravado porque é a EVIDÊNCIA do percurso: o que a professora lê no painel
  /// e o que o estudante copiou têm de ser o mesmo texto, e uma recompilação
  /// futura com a copy revisada mudaria o documento que já foi assinado.
  manifestoMarkdown String? @map("manifesto_markdown")

  /// A versão do instrumento, na linha, para permitir reprocessamento histórico
  /// quando o catálogo mudar (DAD-06).
  versaoInstrumento String @default("1.0.0") @map("versao_instrumento")

  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  concluidoEm  DateTime? @map("concluido_em") @db.Timestamptz(6)

  estudante  User             @relation("Exp08ef4bEstudante", fields: [estudanteId], references: [id], onDelete: Cascade)
  auditorias Exp08ef4bAuditoria[]
  percursos  Exp08ef4bPercurso[]

  @@id([escolaId, estudanteId])
  @@index([escolaId])
  @@index([escolaId, turmaId])
  @@map("exp08ef4b_sessoes")
}

/// Cada questionamento disparado contra a máquina na Etapa 2.
///
/// 1:N de propósito: a cota de 2 é sobre prompts DISTINTOS, e guardar só o
/// contador perderia QUAIS a criança escolheu — que é o dado da hipótese
/// pedagógica (a contradição só aparece no prompt do preconceito histórico).
model Exp08ef4bAuditoria {
  id          BigInt @id @default(autoincrement())
  escolaId    String @map("escola_id")
  estudanteId String @map("estudante_id") @db.Uuid
  /// Id do catálogo (`prompt_origem_dados`…), validado contra o pacote da
  /// turma antes de gravar.
  promptId    String @map("prompt_id")
  /// Ordem do disparo na conversa: 1 e 2 são os obrigatórios, 3 é o extra de
  /// quem quis ouvir a terceira defesa.
  iteracao    Int
  /// Segundos entre o seletor abrir e o envio. Calibragem de fluxo, não mérito.
  latenciaSeg Int    @default(0) @map("latencia_seg")

  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  sessao Exp08ef4bSessao @relation(fields: [escolaId, estudanteId], references: [escolaId, estudanteId], onDelete: Cascade)

  /// Reenviar o mesmo questionamento não é auditoria nova: o UNIQUE faz a
  /// dedupe valer mesmo se um caminho novo esquecer de checar antes.
  @@unique([escolaId, estudanteId, promptId])
  @@index([escolaId, estudanteId])
  @@map("exp08ef4b_auditorias")
}

/// O "MEU PERCURSO" — as 2 palavras-chave e o parágrafo autoral da Etapa 5.
///
/// **Texto livre escrito por menor de idade**, e o dado mais sensível daqui.
/// Nunca vai a log (`justificativaTexto` está em `CHAVES_REDIGIDAS`), nunca à
/// telemetria analítica (o Pub/Sub leva números e enums), e nenhuma rota de
/// gestor o alcança: quem lê é o professor da turma dela. LGPD art. 14 +
/// `invariantes.ts`.
///
/// RETENÇÃO: vinculada à vigência contratual escolar, **sem rotina ativa de
/// expurgo programado** (DAD-10). A frase é literal e a escolha é deliberada:
/// não existe scheduler de expurgo na plataforma, e declarar "um ano letivo"
/// aqui seria escrever um prazo que ninguém cumpre — a armadilha do
/// `expires_at` que o `AGENTS.md` da raiz cita.
model Exp08ef4bPercurso {
  escolaId    String @map("escola_id")
  estudanteId String @map("estudante_id") @db.Uuid

  /// Exatamente 2, distintas (CHECK na migration). São ids minúsculos sem
  /// acento — identificador, não texto de tela (ADR-91).
  tags String[] @map("palavras_chave_tags")

  /// O parágrafo. Passou pelo filtro de dado pessoal ANTES de chegar aqui: o
  /// que casa o regex é RECUSADO com 422 e não gravado, então esta coluna não
  /// tem flag de moderação — não há registro moderado a marcar.
  justificativaTexto String @map("justificativa_texto") @db.Text
  charsCount         Int    @map("chars_count")

  versaoInstrumento String @default("1.0.0") @map("versao_instrumento")

  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  sessao Exp08ef4bSessao @relation(fields: [escolaId, estudanteId], references: [escolaId, estudanteId], onDelete: Cascade)

  @@id([escolaId, estudanteId])
  @@index([escolaId])
  @@map("exp08ef4b_respostas_percurso")
}

/// O CHECKPOINT A — por TURMA. É o que congela 30 telas para o debate oral.
///
/// **Tabela, e não WebSocket** (ADR-93). A infraestrutura Cloud Run da
/// plataforma não tem WebSocket de aplicação: o handoff original previa um
/// broadcast `hub:pause`, e ele não existe. O congelamento é uma LINHA aqui que
/// a tela do estudante lê por polling HTTP de 5s (`GET /manifesto-ia/gate`).
///
/// Duas etapas só (`regras/passos.ts`): `missao` e `debate`. E, diferente da
/// exp06ef2b, o gate é OPCIONAL — a missão corre inteira sem ninguém apertar nada,
/// porque a spec admite a sessão assíncrona individual. Por isso `debate` mexe
/// só no TETO do passo, nunca no piso: subir o piso empurraria para a frente
/// quem ainda estava auditando a máquina, e são justamente essas crianças que o
/// debate tenta alcançar.
model Exp08ef4bGateTurma {
  escolaId String @map("escola_id")
  turmaId  String @map("turma_id") @db.Uuid

  /// missao | debate (CHECK na migration).
  etapa String @default("missao")

  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@id([escolaId, turmaId])
  @@index([escolaId])
  @@map("exp08ef4b_gates_turma")
}

// ═══════════════════════════════════════════ exp01ef1b — o que a foto conta
//
// A missão do 1º ano EF: escolher enquadramento e legenda no mural da turma
// (clone do Instagram) e descobrir que toda foto mostra uma escolha. 100%
// formativa (sem score somativo, por diretriz de 1EF), conduzida em aula pelo
// professor: a Etapa 5 congela os tablets num LATCH que só ele libera.

/// A configuração da aula, POR TURMA: o pacote de fotos/legendas (gerado por IA
/// e aprovado pelo professor, ou o banco curado padrão quando `pacote` é null)
/// e o interruptor do latch da Roda de Conversa.
///
/// `tentativa` é a rotação de sessão do "Zerar e Reiniciar Turma": o reset
/// incrementa o número em vez de apagar runs — as antigas ficam arquivadas na
/// tentativa anterior (DAD-06: dado legado imutável), e a run ativa é sempre a
/// da tentativa corrente.
model FotoContaTurmaConfig {
  escolaId String @map("escola_id")
  turmaId  String @map("turma_id") @db.Uuid

  /// recreio | nossa_horta | sala_de_aula | parquinho (CHECK na migration).
  tema String @default("recreio")
  /// nivel_1 (palavras curtas) | nivel_2 (frases simples) (CHECK na migration).
  complexidade String @default("nivel_1")
  /// pendente | pronto (CHECK). `pronto` = o professor aprovou (o
  /// `cfg_turma_ready` da spec); sem aprovação até a aula, o banco padrão vale.
  statusPacote String @default("pendente") @map("status_pacote")
  /// O pacote APROVADO (validado por `PacoteDaTurmaSchema`). Null = banco
  /// curado padrão do `catalogo.ts` — o fallback que nunca deixa a aula sem
  /// material.
  pacote Json?
  /// Se o pacote aprovado veio da IA (auditoria do painel; o professor pode
  /// ter editado os textos antes de aprovar).
  pacoteDaIa Boolean @default(false) @map("pacote_da_ia")

  /// O latch da Etapa 5 (Roda de Conversa). `false` congela os tablets da
  /// turma; o professor libera UMA vez por aula (o reset o rearma).
  latchLiberado Boolean @default(false) @map("latch_liberado")

  tentativa Int @default(1) @db.SmallInt

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@id([escolaId, turmaId])
  @@index([escolaId])
  @@map("exp01ef1b_turma_config")
}

/// A execução de UM estudante em UMA tentativa da turma.
///
/// Payloads de tempo real e telemetria carregam SÓ `estudante_id` (regra 6 /
/// DAD-07): o nome entra na resposta do painel do professor, hidratado na rota
/// autenticada pela matrícula da turma — nunca gravado aqui.
model FotoContaRun {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId    String @map("escola_id")
  turmaId     String @map("turma_id") @db.Uuid
  estudanteId String @map("estudante_id") @db.Uuid
  tentativa   Int    @default(1) @db.SmallInt

  /// desafiar | feed | decidir | aha | roda | refletir | concluida (CHECK).
  /// `roda` é o latch: a run só sai dele quando o professor libera a turma.
  etapa String @default("desafiar")

  /// coruja | estrela | sol (CHECK) — a "marca" da Etapa 1 (cosmético).
  marcaId String? @map("marca_id")
  /// Id da foto escolhida no pacote (ex.: `par_a`, `par_b`).
  fotoEscolhidaId String? @map("foto_escolhida_id") @db.VarChar(30)
  /// Id da legenda escolhida no pacote (`legenda_1`, `legenda_2`).
  legendaEscolhidaId String? @map("legenda_escolhida_id") @db.VarChar(30)
  /// Milissegundos entre entrar na tela de decisão e publicar. Teto de 2h no
  /// CHECK: acima disso é aba esquecida, não tempo de decisão.
  latenciaDecisaoMs Int? @map("latencia_decisao_ms")

  /// Exploração do feed (grau `none`: cosmético/motor, sem peso avaliativo).
  curtidasFeed     Int @default(0) @map("curtidas_feed") @db.SmallInt
  permanenciaFeedMs Int @default(0) @map("permanencia_feed_ms")

  /// `lupa` (CHECK) — só a resposta que CONCLUI é gravada; o Globo é retry
  /// formativo e vive em `tentativas_reflexao`, nunca como resposta final.
  reflexaoFinal      String? @map("reflexao_final")
  tentativasReflexao Int     @default(0) @map("tentativas_reflexao") @db.SmallInt

  versaoInstrumento String @default("1.0.0") @map("versao_instrumento")

  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  concluidoEm  DateTime? @map("concluido_em") @db.Timestamptz(6)

  estudante User               @relation("FotoContaEstudante", fields: [estudanteId], references: [id], onDelete: Cascade)
  post      FotoContaPostTurma?

  @@unique([escolaId, turmaId, estudanteId, tentativa], map: "exp01ef1b_run_unica_por_tentativa")
  @@index([escolaId, turmaId, tentativa])
  @@map("exp01ef1b_runs")
}

/// A publicação no mural coletivo — o que a Galeria da Turma mostra.
///
/// Carrega o CONTEÚDO renderizável (ids do pacote + texto da legenda) e nunca
/// o nome da criança: quem assina o post na tela é a MARCA (coruja/estrela/
/// sol), que é a identidade da ficção.
model FotoContaPostTurma {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId    String @unique @map("run_id") @db.Uuid
  escolaId String @map("escola_id")
  turmaId  String @map("turma_id") @db.Uuid
  tentativa Int   @default(1) @db.SmallInt

  marcaId        String @map("marca_id")
  fotoId         String @map("foto_id") @db.VarChar(30)
  legendaTexto   String @map("legenda_texto") @db.VarChar(100)
  curtidasSimuladas Int @default(0) @map("curtidas_simuladas")

  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  run FotoContaRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([escolaId, turmaId, tentativa])
  @@map("exp01ef1b_posts_turma")
}

/// O TETO DIÁRIO DE IA POR PERFIL (ADR-105) — a quota que `QuotaService`
/// consulta ANTES de cada chamada de IA. Uma linha por perfil, escopo do
/// CONTRATO inteiro (sem `escola_id`: 1 contrato = 1 stack). Vocabulário
/// FECHADO (`estudante` | `professor`, CHECK na migration espelhando
/// `PERFIS_COM_QUOTA`); todo outro perfil cai na linha `professor`.
///
/// Semeada pela migration com os valores que valiam por env; editada só pelo
/// `admin` em `/unooria/uso-de-ia`. A linha é SOBRESCRITA — o histórico de
/// quem mudou vive em `recursos_auditoria` (ação `quota-alterada`). SEM RLS e
/// sem FK em `definido_por`, pelas razões escritas na migration.
model IaQuota {
  perfil       String  @id
  tokensPorDia Int     @map("tokens_por_dia")
  motivo       String?
  /// NULO = veio da migration; ninguém decidiu ainda.
  definidoPor  String?  @map("definido_por") @db.Uuid
  definidoEm   DateTime @default(now()) @map("definido_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@map("ia_quotas")
}

/// CADASTRO DE INTERESSE do site público (ADR-107) — quem pediu contato pelo
/// formulário do ENTRE REDES, antes de existir contrato.
///
/// É a única tabela do banco que NÃO é de gente da rede: quem escreve aqui é um
/// visitante, e a linha nasce numa rota sem sessão. Daí as três diferenças que
/// a migration justifica: sem `escola_id` (não há escola ainda), sem RLS (não
/// há tenant a isolar) e sem vínculo com `users`.
///
/// `consentimentoTexto` guarda a FRASE que a pessoa marcou, não um booleano
/// solto: consentimento que não registra a que se consentiu não prova nada
/// (LGPD art. 8º, §2º). Se o texto do site mudar, as linhas antigas continuam
/// dizendo o que valia no dia.
model ProspeccaoLead {
  id                 String   @id @default(uuid()) @db.Uuid
  nome               String
  /// Guardado em minúsculas: é a chave que separa um reenvio de um cadastro novo.
  email              String
  telefone           String
  organizacao        String
  cargo              String
  consentimentoTexto String   @map("consentimento_texto")
  criadoEm           DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([email, criadoEm], map: "prospeccao_leads_email_criado_em_idx")
  @@index([criadoEm(sort: Desc)], map: "prospeccao_leads_criado_em_idx")
  @@map("prospeccao_leads")
}

// ════════════════════════════════════════ exp05ef1b — quem mandou isso?
//
// "Quem Mandou Isso?" — 5º ano EF, unidade 1. O estudante entra num grupo de
// mensagens da turma, encaminha para o Mural o que julga importante, CONFIRMA —
// e só então a professora acende o telão com o histograma da sala. A descoberta
// é sobre o próprio dedo: a mentira chegou mais longe porque ele a encaminhou.
//
// CINCO tabelas, e o desenho segue a exp08ef4b: o que é 1:1 com a sessão é COLUNA
// da sessão (`leu_tudo`, `midias_abertas`, `confirmado_em`), não tabela. A
// exceção é `exp05ef1b_encaminhamentos`, 1:N de propósito — o dado da missão é
// QUAIS mensagens foram ao Mural, e é dele que sai o histograma; um contador
// diria "encaminhou 4" e perderia a única coisa que a revelação mostra.
//
// A tabela de conteúdo, aqui, é mais dura que a da exp08ef4b: lá a turma sem
// preparo cai no banco curado e a aula corre; aqui não há queda, porque o lote
// é do TEMA que a professora escolheu e um tema alheio faria a criança ler
// mensagens sobre um acontecimento que não existiu na escola dela. Sem
// homologação, a missão do estudante é uma tela de espera.
//
// SEM COLUNA DE PONTUAÇÃO em lugar nenhum, e a ausência é o desenho (PED-11,
// `invariantes.ts`): a missão não pontua ninguém. Com o gabarito a um JOIN de
// distância, "quantas falsas cada um encaminhou" é a coluna que se escreve
// sozinha — e ela é um ranking de quem caiu no boato.
//
// CHECKs e RLS vivem na migration.

/// O LOTE DA TURMA — as 8 mensagens que a professora homologou, COM o gabarito.
///
/// Uma linha por turma. `aprovadoPorProfessor` é o portão da curadoria humana
/// (RF-001): sem ele `true` a experiência do estudante fica em ESPERA. É a
/// diferença para a exp08ef4b — lá o não-preparo cai no banco curado, aqui não há
/// queda, porque o lote inteiro é escrito em cima do tema que ela escolheu.
///
/// Sobrevive ao "Zerar turma", como o pacote da exp08ef4b: o preparo custou tempo
/// dela, e apagá-lo junto com as respostas obrigaria a refazer a curadoria para
/// reaplicar a missão na turma seguinte no mesmo dia.
model Exp05ef1bConteudoTurma {
  escolaId String @map("escola_id")
  turmaId  String @map("turma_id") @db.Uuid

  /// O acontecimento da escola, como a professora o escreveu no preparo.
  tema String

  /// urgencia | indignacao | medo (CHECK na migration). O foco emocional que o
  /// gerador recebe — e o que faz a mesma missão soar diferente em duas turmas.
  gatilho String

  /// ia | padrao (CHECK na migration). **`padrao` NÃO é fallback de erro**: é o
  /// banco curado da Unooria, homologado, que a professora aprova com um clique
  /// quando não quer gerar nada. Guardar a origem é o que permite responder
  /// depois se a curadoria assistida está sendo usada — e o "não" não é defeito.
  origem String

  /// As 8 mensagens COM `veracidade`, `tom` e `explicacao`. `Json` e não
  /// tabela-filha porque o lote é lido e escrito SEMPRE inteiro — a professora
  /// aprova o conjunto, não uma mensagem de cada vez —, e normalizá-lo produziria
  /// oito linhas com uma FK cada para nada. O schema real é o Zod de
  /// `contrato-de-rotas.ts` (o Prisma não valida forma de Json); o CHECK da
  /// migration cobra o que o Zod não alcança quando a linha nasce por outro
  /// caminho: array, e com oito.
  mensagensJson Json @map("mensagens_json")

  /// O clique formal em "Aprovar e liberar para a turma". Falso = rascunho, e
  /// rascunho não abre a missão para ninguém.
  aprovadoPorProfessor Boolean @default(false) @map("aprovado_por_professor")

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@id([escolaId, turmaId])
  @@index([escolaId])
  @@map("exp05ef1b_conteudo_turma")
}

/// A sessão do estudante na missão. Uma por estudante e por escola.
model Exp05ef1bSessao {
  escolaId    String  @map("escola_id")
  estudanteId String  @map("estudante_id") @db.Uuid
  /// Denormalizado da identidade, como na exp06ef2b e na exp08ef4b: o painel e o gate
  /// da turma consultam por turma o tempo todo.
  turmaId     String? @map("turma_id") @db.Uuid

  /// contexto | curadoria | espera | revelado | reflexao | fim
  /// (CHECK na migration; a ordem é `regras/passos.ts`).
  passo String @default("contexto")

  /// Quando tocou "Entrar no grupo". Não é o `criadoEm`: a linha nasce ao abrir
  /// a experiência, e o relógio da impulsividade só começa quando a primeira
  /// mensagem aparece na tela.
  entrouEm                 DateTime? @map("entrou_em") @db.Timestamptz(6)
  /// O primeiro encaminhamento. Com `entrouEm` dá o "tempo até o primeiro
  /// encaminhamento" do painel — o indicativo de impulsividade, que é o dado
  /// central desta missão. Coluna, e não `MIN(criado_em)` dos encaminhamentos:
  /// a leitura do painel é por turma inteira, e um agregado por estudante a
  /// cada polling de 5 s pagaria o mesmo número trinta vezes por aula.
  primeiroEncaminhamentoEm DateTime? @map("primeiro_encaminhamento_em") @db.Timestamptz(6)

  /// Rolou até a 8ª mensagem. Junto com o piso de 3, é o que libera "Confirmar
  /// envio" (`regras/curadoria.ts`): sem ele a criança fecha o Mural com as três
  /// primeiras e nunca vê o esclarecimento do professor, que é a `msg-7`.
  leuTudo Boolean @default(false) @map("leu_tudo")

  /// Os ids cuja transcrição do áudio ou card do link foi ABERTA. É indicativo
  /// de leitura, nunca mérito. Coluna e não tabela: é 1:1 com a sessão, e a
  /// convenção do repo é que 1:1 não vira tabela (exp06ef2b, exp08ef4b).
  midiasAbertas String[] @default([]) @map("midias_abertas")

  /// O LATCH. Carimbado em "Confirmar envio" e irreversível: a partir daqui o
  /// Mural não muda mais, e é esta linha que entra na conta da turma. Null = a
  /// curadoria ainda está aberta, e o que ela escolheu não conta para ninguém.
  confirmadoEm DateTime? @map("confirmado_em") @db.Timestamptz(6)

  /// A versão do instrumento, na linha, para permitir reprocessamento histórico
  /// quando o catálogo mudar (DAD-06).
  versaoInstrumento String @default("1.0.0") @map("versao_instrumento")

  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  concluidoEm  DateTime? @map("concluido_em") @db.Timestamptz(6)

  estudante       User                  @relation("Exp05ef1bEstudante", fields: [estudanteId], references: [id], onDelete: Cascade)
  encaminhamentos Exp05ef1bEncaminhamento[]
  reflexoes       Exp05ef1bReflexao[]

  @@id([escolaId, estudanteId])
  @@index([escolaId])
  @@index([escolaId, turmaId])
  @@map("exp05ef1b_sessoes")
}

/// Cada mensagem que o estudante mandou para o Mural da Turma.
///
/// 1:N de propósito: QUAIS mensagens foram encaminhadas é o dado do histograma
/// e do card de síntese (`regras/curadoria.ts` monta os dois a partir dos
/// snapshots dos confirmados). Um contador na sessão diria "encaminhou 4" e
/// perderia exatamente a coisa que o telão mostra — que a sala inteira mandou
/// a mesma mensagem falsa.
model Exp05ef1bEncaminhamento {
  id          BigInt @id @default(autoincrement())
  escolaId    String @map("escola_id")
  estudanteId String @map("estudante_id") @db.Uuid
  /// msg-1 … msg-8 (CHECK na migration), validado contra o lote da turma antes
  /// de gravar.
  mensagemId  String @map("mensagem_id")

  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  sessao Exp05ef1bSessao @relation(fields: [escolaId, estudanteId], references: [escolaId, estudanteId], onDelete: Cascade)

  /// Encaminhar duas vezes não conta duas. A regra pura já deduplica com um
  /// `Set`, e o UNIQUE faz a dedupe valer quando dois toques rápidos no mesmo
  /// balão chegam como duas requisições em paralelo — que é o caminho normal
  /// numa sala com trinta tablets, não a exceção.
  @@unique([escolaId, estudanteId, mensagemId])
  @@index([escolaId, estudanteId])
  @@map("exp05ef1b_encaminhamentos")
}

/// A reflexão final — a resposta ao dilema do áudio do tio, em texto livre.
///
/// **Texto livre escrito por menor de idade**, e o dado mais sensível daqui.
/// Não vai a log (`texto` está em `CAMPOS_SENSIVEIS` de `invariantes.ts`), não
/// vai à telemetria analítica, e nenhuma rota de gestor o alcança: quem lê é o
/// professor da turma dela, pela RLS mais o recorte da rota. LGPD art. 14.
///
/// **Sem criptografia em nível de aplicação**, e a ausência é decisão: o repo
/// não tem nenhuma, o Cloud SQL já cifra em repouso, e uma coluna cifrada só
/// aqui criaria a chave que ninguém sabe onde rodar — e tiraria a reflexão do
/// painel que é a razão de ela existir.
///
/// RETENÇÃO: vinculada à vigência contratual escolar, **sem rotina ativa de
/// expurgo programado** (DAD-10), como na exp08ef4b. Declarar "um ano letivo" aqui
/// seria escrever um prazo que nenhum scheduler cumpre.
model Exp05ef1bReflexao {
  escolaId    String @map("escola_id")
  estudanteId String @map("estudante_id") @db.Uuid

  /// 5 a 500 caracteres — o teto do campo na tela (`TETO_DA_REFLEXAO`). O piso
  /// é o CHECK da migration: o tipo não impede cinco espaços, e cinco espaços
  /// contariam como reflexão entregue no painel da professora.
  texto      String @db.VarChar(500)
  charsCount Int    @map("chars_count")

  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  sessao Exp05ef1bSessao @relation(fields: [escolaId, estudanteId], references: [escolaId, estudanteId], onDelete: Cascade)

  @@id([escolaId, estudanteId])
  @@index([escolaId])
  @@map("exp05ef1b_reflexoes")
}

/// O RELÓGIO DA TURMA — os dois botões mestres da professora, e o inverso.
///
/// **Tabela, e não WebSocket** (ADR-93): a infraestrutura Cloud Run da
/// plataforma não tem WebSocket de aplicação. "Iniciar revelação coletiva" é uma
/// LINHA aqui que a tela do estudante lê por polling HTTP de 5 s.
///
/// Três etapas (`regras/passos.ts`): `exploracao`, `revelacao`, `reflexao`. O
/// card de síntese entra JUNTO da revelação — um terceiro botão para ele seria
/// controle morto no painel.
///
/// Diferente da exp08ef4b, aqui a etapa mexe no PISO: quando o telão acende, quem
/// não confirmou é empurrado para `revelado`. Deixá-lo continuar encaminhando
/// com o gabarito projetado na parede mediria outra coisa.
model Exp05ef1bGateTurma {
  escolaId String @map("escola_id")
  turmaId  String @map("turma_id") @db.Uuid

  /// exploracao | revelacao | reflexao (CHECK na migration).
  etapa String @default("exploracao")

  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@id([escolaId, turmaId])
  @@index([escolaId])
  @@map("exp05ef1b_gates_turma")
}

/// A MONTAGEM DAS EQUIPES de uma missão numa turma (E13, ADR-111): quantos
/// computadores a sala tem hoje, como as equipes nasceram e quem faltou.
///
/// **Equipe é quem DIVIDE UM COMPUTADOR**, e não agrupamento pedagógico. A
/// escola pública tem menos máquinas que crianças, e sem isto a plataforma
/// contava a sala como se cada estudante tivesse a própria tela — o painel
/// dizia "12 não começaram" quando os 12 estavam sentados ao lado de quem
/// começou.
///
/// Uma linha por (turma × missão), e é ELA que carrega a `versao` da
/// concorrência otimista: duas telas do mesmo professor (o computador da sala e
/// o celular) salvando ao mesmo tempo não podem se sobrescrever em silêncio.
///
/// **Sem FK de `exp_id` para `experiencias`**, pelo mesmo motivo de
/// `liberacoes.exp_id`: aquele catálogo é escrito pelo CI ao publicar, e em dev
/// está vazio. Quem restringe as missões que aceitam equipe é
/// `equipes/regras.ts#EXPERIENCIAS_COM_EQUIPE`, no código.
model EquipesMontagem {
  escolaId String @map("escola_id")
  turmaId  String @map("turma_id") @db.Uuid
  expId    String @map("exp_id")

  /// sorteio | manual — CHECK na migration. `manual` nasce com N equipes
  /// VAZIAS: quem distribui é o professor, que conhece quem senta com quem.
  modo String

  /// Quantos computadores a sala tem nesta aula. É o número de equipes do
  /// sorteio, e muda de aula para aula (o laboratório divide horário).
  computadores Int

  /// Quem faltou na hora de montar. Fica fora do sorteio, e não é matrícula:
  /// amanhã a criança volta e entra no próximo.
  ausentes String[] @default([]) @db.Uuid

  /// A concorrência otimista: o `PUT` diz em qual versão se baseou, e versão
  /// velha é 409. Começa em 1 — `0` é o que o cliente manda quando não havia
  /// montagem nenhuma.
  versao Int @default(1)

  /// Quem salvou por último. Sem FK, de propósito: é carimbo de auditoria, e
  /// uma FK para `users` faria a saída de um professor da rede apagar (ou
  /// travar) a montagem da turma inteira.
  atualizadoPor String   @map("atualizado_por") @db.Uuid
  atualizadoEm  DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  turma   Turma    @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  equipes Equipe[]

  @@id([escolaId, turmaId, expId])
  @@index([escolaId, turmaId])
  @@map("equipes_montagens")
}

/// Uma EQUIPE: um computador, um nome e quem senta diante dele.
///
/// O nome é o que a criança lê na tela ("Equipe 3") e o professor pode trocar;
/// o UNIQUE por missão existe porque duas "Equipe 3" no mesmo painel são a
/// dúvida que ninguém consegue resolver no meio da aula.
model Equipe {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId String @map("escola_id")
  turmaId  String @map("turma_id") @db.Uuid
  expId    String @map("exp_id")

  /// 1 a 30 caracteres depois do `trim` — CHECK na migration e `NOME_MAX` no
  /// código. O teto é o que cabe no card do painel sem quebrar a linha.
  nome String

  /// A ordem em que o professor montou. É a ordem da tela, e não o nome:
  /// "Equipe 10" viria antes de "Equipe 2" na ordem alfabética.
  ordem Int

  montagem EquipesMontagem @relation(fields: [escolaId, turmaId, expId], references: [escolaId, turmaId, expId], onDelete: Cascade)
  membros  EquipeMembro[]

  @@unique([escolaId, turmaId, expId, nome])
  @@index([escolaId, turmaId, expId])
  @@map("equipes")
}

/// Quem está em qual equipe.
///
/// `turma_id` e `exp_id` REPETIDOS da equipe, e é isso que torna possível o
/// UNIQUE que importa: **uma criança, uma equipe por missão**. Sem as colunas
/// aqui, a regra só existiria no código, e dois `PUT` em paralelo poriam a
/// mesma criança em dois computadores.
model EquipeMembro {
  escolaId    String @map("escola_id")
  equipeId    String @map("equipe_id") @db.Uuid
  turmaId     String @map("turma_id") @db.Uuid
  expId       String @map("exp_id")
  estudanteId String @map("estudante_id") @db.Uuid

  equipe    Equipe @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  estudante User   @relation("EquipeMembroEstudante", fields: [estudanteId], references: [id], onDelete: Cascade)

  @@id([equipeId, estudanteId])
  @@unique([escolaId, turmaId, expId, estudanteId])
  @@index([escolaId, estudanteId])
  @@map("equipes_membros")
}

/// UMA MARCA da ficha pedagógica (E14): o que a missão viu o estudante fazer
/// numa atividade, numa rodada — uma AÇÃO ("tirou o post do ar") ou a
/// resposta de uma PERGUNTA de múltipla escolha.
///
/// É o DADO BRUTO da evidência, e a única tabela que a missão escreve (pela
/// porta `EvidenciasService.marcar`). A evidência que o professor lê
/// (`evidencias`) é DERIVADA daqui: a melhor marca de cada habilidade.
///
/// A chave NÃO leva `turma_id`: a marca é da criança naquela atividade e
/// rodada, e a turma é só o contexto em que ela foi registrada.
///
/// **Sem FK de `exp_id` para `experiencias`** (catálogo vazio em dev), como
/// `liberacoes` e `equipes_montagens`. O `estudante_id` TEM FK (a trava da
/// identidade única), com cascata: a marca é dado da criança.
model EvidenciaMarca {
  escolaId    String @map("escola_id")
  turmaId     String @map("turma_id") @db.Uuid
  expId       String @map("exp_id")
  /// O id da ATIVIDADE, dado pela missão — texto opaco para a plataforma
  /// (`[A-Za-z0-9_.:-]`, 1 a 100; CHECK na migration e `ATIVIDADE_ID_RE`).
  atividadeId String @map("atividade_id")
  /// Reiniciar uma atividade abre uma rodada NOVA (≥ 1); a anterior fica.
  rodada      Int
  estudanteId String @map("estudante_id") @db.Uuid
  /// O código BNCC que este marcador mede, copiado da ficha no registro.
  habilidade  String
  /// O id do marcador na ficha.
  marcador    String
  /// atingiu | em_processo | nao_atingiu — CHECK na migration.
  status      String
  /// acao | multipla_escolha — CHECK na migration. Na ação vale a MELHOR
  /// marca; na pergunta, a PRIMEIRA resposta.
  tipo        String
  /// A versão da ficha em vigor quando a marca foi registrada.
  versaoFicha Int    @map("versao_ficha")

  /// É por ela que se acha a RODADA EM ANDAMENTO da turma × missão: a da marca
  /// mais recente. Só ela é recalculada quando as equipes mudam.
  registradaEm DateTime @default(now()) @map("registrada_em") @db.Timestamptz(6)

  turma     Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  estudante User  @relation("EvidenciaMarcaEstudante", fields: [estudanteId], references: [id], onDelete: Cascade)

  @@id([escolaId, expId, atividadeId, rodada, estudanteId, marcador])
  @@index([escolaId, turmaId, expId, registradaEm])
  @@map("evidencias_marcas")
}

/// A EVIDÊNCIA de uma habilidade: o nível de UM estudante numa habilidade da
/// BNCC, numa atividade, numa rodada (E14). É o que o painel do professor lê.
///
/// **N/A ("Não avaliado") é a AUSÊNCIA de linha.** `nao_participou` é outra
/// coisa: um N/A EXPLÍCITO, posto pelo professor, que existe para BARRAR a
/// cópia da equipe ("ela faltou; não herda o que o colega fez").
///
/// A precedência entre as origens é regra de `evidencias/regras.ts`:
/// professor > própria > cópia da equipe. A cópia da PROJEÇÃO (a turma
/// inteira diante de um computador só) nasce `a_revisar` e não conta até o
/// professor confirmar.
///
/// `equipe_id` sem FK, de propósito: as equipes são TROCADAS INTEIRAS a cada
/// `PUT` (ADR-111), e uma FK apagaria (ou travaria) a evidência junto. O
/// `estudante_id` tem FK com cascata (a trava da identidade única).
model Evidencia {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId    String @map("escola_id")
  turmaId     String @map("turma_id") @db.Uuid
  expId       String @map("exp_id")
  atividadeId String @map("atividade_id")
  rodada      Int
  estudanteId String @map("estudante_id") @db.Uuid
  habilidade  String

  /// atingiu | em_processo | nao_atingiu | nao_participou — CHECK na migration.
  status   String
  /// propria | equipe | projecao | professor — CHECK na migration.
  origem   String
  /// valida | a_revisar — CHECK na migration. `a_revisar` só na projeção.
  situacao String

  /// De quem a cópia veio (origem `equipe` ou `projecao`), e só nelas.
  fonteEstudanteId String? @map("fonte_estudante_id") @db.Uuid
  /// A equipe da cópia no momento em que ela foi feita. Carimbo, sem FK.
  equipeId         String? @map("equipe_id") @db.Uuid
  /// Quem ajustou (origem `professor`), e só nela. Carimbo, sem FK.
  editadoPor       String? @map("editado_por") @db.Uuid

  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  turma     Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  estudante User  @relation("EvidenciaEstudante", fields: [estudanteId], references: [id], onDelete: Cascade)

  @@unique([escolaId, expId, atividadeId, rodada, estudanteId, habilidade])
  @@index([escolaId, turmaId, expId, atividadeId, rodada])
  @@index([escolaId, estudanteId])
  @@map("evidencias")
}

/// O HISTÓRICO da evidência (E14): toda mudança, com de/para, quem e quando.
///
/// **APPEND-ONLY no banco**: um trigger recusa `UPDATE` para qualquer role, e
/// a role de runtime só recebe `SELECT, INSERT`. É o que responde "quem mudou
/// a nota da Ana, e de quê para quê?" meses depois — reescrever uma linha é o
/// único jeito de ele mentir.
///
/// `estudante_id` e `habilidade` são nulos no evento da TURMA (a
/// confirmação da projeção vale para todos de uma vez).
model EvidenciaEvento {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId    String  @map("escola_id")
  turmaId     String  @map("turma_id") @db.Uuid
  expId       String  @map("exp_id")
  atividadeId String  @map("atividade_id")
  rodada      Int
  estudanteId String? @map("estudante_id") @db.Uuid
  habilidade  String?

  /// marca | copia | recalculo | confirmacao | ajuste — CHECK na migration.
  tipo String
  /// O estado ANTES (`null` = não havia linha) e DEPOIS (`null` = a linha saiu).
  de   Json?
  para Json?

  /// Quem causou: o estudante na marca, o professor no ajuste e na
  /// confirmação, `null` no que a plataforma recalculou sozinha.
  autorId  String?  @map("autor_id") @db.Uuid
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  turma     Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  /// Cascata, e não `SET NULL`: anular a coluna seria um `UPDATE`, que o
  /// trigger do append-only recusa — e a saída da criança travaria.
  estudante User? @relation("EvidenciaEventoEstudante", fields: [estudanteId], references: [id], onDelete: Cascade)

  @@index([escolaId, turmaId, expId, atividadeId, rodada])
  @@index([escolaId, estudanteId])
  @@map("evidencias_eventos")
}

// ════════════════════════════════════════ exp07ef1b — a seleção
//
// "A Seleção" — 7º ano EF, unidade 1, no clone do Instagram. O estudante rola
// um feed de 12 posts de três veículos sobre o mesmo evento, poda os salvos até
// três, publica nos Stories do grêmio com uma legenda (o LATCH) — e no Mural da
// Turma vê a própria tríade ao lado da de um colega que contou outra história
// com os mesmos fatos. A descoberta é sobre o próprio recorte.
//
// QUATRO tabelas. A ATIVIDADE (no sentido da evidência pedagógica, ADR-112) é a
// COBERTURA homologada, e a RODADA é o "Zerar turma": zerar sobe a rodada no
// gate e as sessões antigas FICAM — o histórico é exigência da ADR-112. Tema
// novo é atividade nova, na rodada 1.
//
// O dado do Mural é do COMPUTADOR (a resposta desta missão ao gatilho da
// ADR-111): o pareamento colapsa as equipes, e o par fica CONGELADO na sessão
// (`par_sessao_id`, `par_virtual`, `par_rotulo`) — nunca `equipe:<id>`, porque
// o PUT das equipes recria os ids.
//
// SEM COLUNA DE PONTUAÇÃO: o nível da EF07CO11 que a IA gradua vai para
// `evidencias`, não para cá.
//
// CHECKs, RLS e o índice único parcial vivem na migration.

/// Uma COBERTURA — os 12 posts que a turma lê, COM o gabarito. É a atividade.
///
/// Uma ATIVA por turma (índice único parcial na migration). Sem homologação, a
/// turma roda o banco curado da Praça Central: a cobertura `padrao` nasce na
/// primeira entrada, e a missão NÃO nasce vazia — ao contrário da exp05ef1b, o
/// banco curado é uma cobertura completa, e não um tema alheio.
///
/// Homologar um tema novo DESATIVA a anterior (a linha fica, com as sessões
/// dela) e abre a rodada 1 da nova.
model Exp07ef1bCobertura {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId String  @map("escola_id")
  turmaId  String  @map("turma_id") @db.Uuid
  tema     String
  /// O foco regional que a professora deu ao gerador ("Bairro Jardim das Flores").
  foco     String?
  /// padrao | ia (CHECK). `padrao` é o banco curado, não fallback de erro.
  origem   String

  /// Os 12 posts COM `enquadramento`, `tagFonte` e `tagAngulo`. `Json` porque o
  /// lote é lido e escrito sempre inteiro; o schema real é o Zod de
  /// `contrato-de-rotas.ts`, e o CHECK cobra array com 12.
  posts Json

  /// As URLs das imagens geradas, por id de post. Aqui, e não no bucket, para o
  /// `GET sessao` de 30 crianças não perguntar ao bucket se cada imagem existe.
  midia Json @default("{}")

  /// Quem homologou. Carimbo sem FK, como `equipes_montagens.atualizado_por`:
  /// a saída de um professor da rede não pode travar a atividade da turma.
  /// Nulo só na `padrao` que nasceu sozinha (CHECK).
  aprovadaPor String? @map("aprovada_por") @db.Uuid

  ativa        Boolean  @default(true)
  criadaEm     DateTime @default(now()) @map("criada_em") @db.Timestamptz(6)
  atualizadaEm DateTime @default(now()) @updatedAt @map("atualizada_em") @db.Timestamptz(6)

  turma   Turma                @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  gates   Exp07ef1bGateTurma[]
  sessoes Exp07ef1bSessao[]

  @@index([escolaId, turmaId], map: "exp07ef1b_coberturas_escola_turma_idx")
  @@map("exp07ef1b_coberturas")
}

/// O RELÓGIO DA TURMA — o botão único do painel (ADR-93: tabela lida por
/// polling de 5 s, nunca WebSocket).
///
/// Diz QUAL atividade e QUAL rodada estão em andamento: a sessão do estudante é
/// a de (cobertura, rodada) deste gate, e o resolvedor da evidência só aceita
/// resposta de enquete dessa sessão.
model Exp07ef1bGateTurma {
  escolaId    String @map("escola_id")
  turmaId     String @map("turma_id") @db.Uuid
  coberturaId String @map("cobertura_id") @db.Uuid
  /// ≥ 1 (CHECK). "Zerar turma" soma um; tema novo volta a 1.
  rodada      Int    @default(1)
  /// exploracao | mural | fichas | explicacao (CHECK; a ordem é `regras/passos.ts`).
  etapa       String @default("exploracao")

  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  turma     Turma              @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  cobertura Exp07ef1bCobertura @relation(fields: [coberturaId], references: [id], onDelete: Cascade)

  @@id([escolaId, turmaId])
  @@index([coberturaId], map: "exp07ef1b_gates_turma_cobertura_idx")
  @@map("exp07ef1b_gates_turma")
}

/// A sessão de UM estudante em UMA rodada de UMA cobertura.
///
/// Zerar abre outra rodada e, com ela, outra linha: a anterior fica, imutável,
/// e é ela que o painel de habilidades lê como a rodada passada.
model Exp07ef1bSessao {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId    String @map("escola_id")
  turmaId     String @map("turma_id") @db.Uuid
  estudanteId String @map("estudante_id") @db.Uuid
  coberturaId String @map("cobertura_id") @db.Uuid
  rodada      Int

  /// desafio | feed | salvos | publicado | mural | fichas | explicacao |
  /// reflexao | enquetes | fim (CHECK; a ordem é `regras/passos.ts`).
  passo String @default("desafio")

  /// Os 3 ids publicados. Nulo antes do latch; com ele, os três juntos com a
  /// legenda, a matriz e o carimbo (CHECK de coerência).
  selecao String[] @default([])
  /// 10 a 140 CODE POINTS (`varchar` conta caracteres, como o `[...s].length`
  /// do Zod). Texto livre de menor que OUTRA criança lê no Mural: passa pelo
  /// sanitizador antes de chegar aqui, e só o professor da turma o vê no painel.
  legenda String?  @db.VarChar(140)
  /// A contagem por lente, calculada NO SERVIDOR a partir da cobertura.
  matriz  Json?

  publicadaEm DateTime? @map("publicada_em") @db.Timestamptz(6)
  concluidaEm DateTime? @map("concluida_em") @db.Timestamptz(6)
  /// O tempo de feed que a tela mediu. INDICATIVO, nunca mérito.
  tempoFeedS  Int?      @map("tempo_feed_s")

  /// O par do Mural, congelado no pareamento. `par_sessao_id` sem FK: a sessão
  /// do par pode sair com a criança (cascata de `users`), e o Mural desta não
  /// pode travar a exclusão da outra.
  parSessaoId String? @map("par_sessao_id") @db.Uuid
  /// tomas | malu (CHECK) — o colega virtual, quando não há par na sala.
  parVirtual  String? @map("par_virtual")
  /// O que a tela escreve sobre o par ("Bia", "Equipe 3", "Tomás"). Congelado:
  /// renomear a equipe depois do Mural não muda o que a sala já viu.
  parRotulo   String? @map("par_rotulo")

  /// A versão do instrumento, para reprocessamento histórico (DAD-06).
  versaoInstrumento String @default("1.0.0") @map("versao_instrumento")

  criadaEm     DateTime @default(now()) @map("criada_em") @db.Timestamptz(6)
  atualizadaEm DateTime @default(now()) @updatedAt @map("atualizada_em") @db.Timestamptz(6)

  turma     Turma              @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  estudante User               @relation("Exp07ef1bEstudante", fields: [estudanteId], references: [id], onDelete: Cascade)
  cobertura Exp07ef1bCobertura @relation(fields: [coberturaId], references: [id], onDelete: Cascade)
  reflexao  Exp07ef1bReflexao?

  @@unique([escolaId, turmaId, estudanteId, coberturaId, rodada], map: "exp07ef1b_sessao_unica_por_rodada")
  @@index([escolaId, turmaId, coberturaId, rodada], map: "exp07ef1b_sessoes_rodada_idx")
  @@index([escolaId, estudanteId], map: "exp07ef1b_sessoes_estudante_idx")
  @@map("exp07ef1b_sessoes")
}

/// A reflexão da Etapa 6 — uma por sessão, e só o professor da turma a lê.
///
/// **Texto livre de menor de idade.** Não vai a log nem à telemetria; no painel
/// só sai para quem leciona (o recorte da ADR-108). Sem criptografia de
/// aplicação, pela mesma decisão da exp05ef1b: o Cloud SQL já cifra em repouso.
///
/// RETENÇÃO: vinculada à vigência contratual, sem rotina de expurgo (DAD-10).
model Exp07ef1bReflexao {
  sessaoId String @id @map("sessao_id") @db.Uuid
  escolaId String @map("escola_id")
  /// 100 a 500 code points — `char_length` no CHECK, `[...s].length` no Zod.
  texto    String
  /// O mesmo número, gravado; o CHECK cobra `chars = char_length(texto)`.
  chars    Int

  criadaEm DateTime @default(now()) @map("criada_em") @db.Timestamptz(6)

  sessao Exp07ef1bSessao @relation(fields: [sessaoId], references: [id], onDelete: Cascade)

  @@index([escolaId], map: "exp07ef1b_reflexoes_escola_idx")
  @@map("exp07ef1b_reflexoes")
}
