  @@index([activityId, lado, perfil, intensidade, aprovado], map: "idx_exp08ef1b_posts_curadoria")
  @@index([escolaId])
  @@map("exp08ef1b_posts")
}

/// comentários fake do post (objeto completo, como no padrão do IG)
model PostComment {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escolaId       String  @map("escola_id")
