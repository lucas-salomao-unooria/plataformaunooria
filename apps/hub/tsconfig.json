{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "declaration": false,
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "isolatedModules": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    // `**/*` NAO alcanca diretorio que comeca com ponto — regra de glob do
    // TypeScript. Sem esta linha, `app/.well-known/jwks.json/route.ts` fica
    // fora do projeto e o typescript-eslint recusa com "not found by the
    // project service". Passava em maquina com `.next/types` de um build
    // antigo (que referencia a rota e a puxava para dentro) e falhava em
    // checkout limpo — ou seja, exatamente no CI.
    "app/.well-known/**/*.ts",
    ".next/types/**/*.ts",
    ".next-prod/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
