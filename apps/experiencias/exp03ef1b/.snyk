# Política do Snyk — ver o comentário em apps/api/.snyk: só entra aqui
# vulnerabilidade cujo fix não cabe agora, com prazo que o portão cumpre.
version: v1.25.0
ignore:
  SNYK-JS-ESBUILD-17750822:
    - '*':
        reason: >-
          esbuild vem do vite (ferramenta de dev — nunca embarca no bundle nem
          roda em produção). O fix (0.28.1) é incompatível com o vite 6: o
          0.28 não faz mais o lowering para os targets default do vite
          (chrome87/es2020), e forçar por override quebra o build de todas as
          experiências. Sobe quando o vite pinar esbuild >=0.28.
        expires: 2026-10-31T00:00:00.000Z
