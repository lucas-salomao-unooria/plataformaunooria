# ===== API (apps/api) =====
DATABASE_URL=postgresql://user:pass@localhost:5432/plataforma
OIDC_ISSUER=https://wso2.seudominio.com.br/oauth2/token   # issuer do WSO2 IS
OIDC_JWKS_URI=https://wso2.seudominio.com.br/oauth2/jwks
OIDC_AUDIENCE=plataforma-api
AI_PROVIDER=vertex            # vertex | anthropic | openai | mock
VERTEX_PROJECT_ID=
VERTEX_LOCATION=southamerica-east1
VERTEX_MODEL=gemini-2.0-flash
AI_DAILY_TOKEN_QUOTA_PER_ALUNO=20000

# ===== HUB (apps/hub) =====
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_CDN_EXP_URL=http://localhost:4173   # em prod: https://cdn.../exp
AUTH_SECRET=troque-me
AUTH_WSO2_ISSUER=https://wso2.seudominio.com.br/oauth2/token
AUTH_WSO2_CLIENT_ID=
AUTH_WSO2_CLIENT_SECRET=
