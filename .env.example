# ===== API (apps/api) — copiar p/ apps/api/.env =====
DATABASE_URL=postgresql://postgres:pass@localhost:5432/unooria

# Emissor dos tokens que a api aceita. HOJE é o hub (NextAuth Credentials +
# chave RS256 própria, JWKS servido pelo próprio hub). Quando o WSO2 entrar,
# troca-se SÓ estes três valores — o OidcGuard não muda.
OIDC_ISSUER=http://localhost:3000
OIDC_JWKS_URI=http://localhost:3000/.well-known/jwks.json
OIDC_AUDIENCE=plataforma-api

AI_PROVIDER=mock              # vertex | mock (mock em dev — sem credencial GCP)
VERTEX_PROJECT_ID=
VERTEX_LOCATION=southamerica-east1
VERTEX_MODEL=gemini-2.0-flash
VERTEX_MODEL_LONGO=gemini-2.5-flash   # saída longa (planos de aula): o 2.0-flash para em 8k tokens
AI_DAILY_TOKEN_QUOTA_PER_ALUNO=20000
AI_DAILY_TOKEN_QUOTA_PER_PROFESSOR=2000000   # ~220k tokens por plano gerado (currículo + material no prompt)
# Planos de aula (exp-90): bucket PRIVADO {contrato}-planos. local em dev = storage-privado/
PLANOS_DRIVER=local           # local | gcs
PLANOS_BUCKET=
PLANOS_LOCAL_DIR=
PLANOS_IMPORT_TOKEN=          # header x-import-token do scripts/importar-referencias-plano.mjs; vazio = rota desligada
TELEMETRIA_TOPIC=             # vazio em dev = eventos logados no console
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175   # hub + dev servers das experiências
PORT=3001

# ===== HUB (apps/hub) — copiar p/ apps/hub/.env.local =====
NEXT_PUBLIC_API_URL=http://localhost:3001
API_INTERNAL_URL=http://localhost:3001      # server-only (authorize/BFF)
NEXT_PUBLIC_CDN_EXP_URL=http://localhost:5173   # em prod: https://cdn.../exp; em dev sem manifesto, cada exp usa a porta de apps/hub/lib/experiencias-dev.ts

# ===== EXPERIÊNCIAS (apps/experiencias/*) — variáveis de BUILD do Vite =====
# exp-02-unootube: base dos 21 mp4 (fora do git). Vazio = ./videos (public/videos, gitignorado, em dev).
# Em prod: https://<cdn-assets>/exp-02-unootube/videos
VITE_VIDEOS_BASE_URL=
HUB_ORIGIN=http://localhost:3000
AUTH_SECRET=troque-me
# Par RS256 que assina os tokens de experiência (gerar com:
# `node apps/hub/scripts/gerar-chave-token.mjs`). Em prod: Secret Manager.
TOKEN_SIGNING_KEY_PEM=
# OIDC/WSO2 (futuro): presença de AUTH_WSO2_ISSUER registra o provider.
AUTH_WSO2_ISSUER=
AUTH_WSO2_CLIENT_ID=
AUTH_WSO2_CLIENT_SECRET=
