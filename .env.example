# ===== API (apps/api) — copiar p/ apps/api/.env =====
DATABASE_URL=postgresql://postgres:pass@localhost:5432/unooria

# Emissor dos tokens que a api aceita. HOJE é o hub (NextAuth Credentials +
# chave RS256 própria, JWKS servido pelo próprio hub). Quando o WSO2 entrar,
# troca-se SÓ estes três valores — o OidcGuard não muda.
OIDC_ISSUER=http://localhost:3000
OIDC_JWKS_URI=http://localhost:3000/.well-known/jwks.json
OIDC_AUDIENCE=plataforma-api

# IA. A credencial é sempre ADC (Application Default Credentials) — nunca chave
# de API: em dev, `gcloud auth application-default login` (o compose monta o
# arquivo resultante dentro do container); em Cloud Run, a service account do
# serviço, sem nenhuma env. Só falta dar `roles/aiplatform.user` a quem chama.
AI_PROVIDER=vertex            # vertex | mock (mock = sem GCP nenhum, devolve texto de exemplo)
VERTEX_PROJECT_ID=            # OBRIGATÓRIO com AI_PROVIDER=vertex (o boot recusa sem ele)
# `global` porque o gemini-3.6-flash não é publicado em região nenhuma (medido:
# 404 em southamerica-east1, us-east1, us-central1). Trocar por uma região
# significa trocar TAMBÉM o modelo pelo que ela publica (lá, a família 2.5).
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.7-flash
VERTEX_MODEL_LONGO=gemini-3.7-flash   # saída longa (planos de aula)
VERTEX_IMAGE_MODEL=gemini-3.1-flash-image   # arte da exp-01 (4:5, pedido ao modelo); o 2.0-flash-exp saiu do catálogo
# Tokens de RACIOCÍNIO dos modelos 2.5 — eles saem do maxOutputTokens, então
# pensamento livre consome o teto do plano anual e devolve texto VAZIO.
# 0 = desligado (paridade com o app origem); -1 = dinâmico; >0 = teto.
VERTEX_THINKING_BUDGET=0
AI_DAILY_TOKEN_QUOTA_PER_ESTUDANTE=300000   # ~4 partidas da exp-03 (uma custa ~77k, MEDIDO)
AI_DAILY_TOKEN_QUOTA_PER_PROFESSOR=2000000   # ~220k tokens por plano gerado (currículo + material no prompt)
# Imagens geradas: local (api serve /assets) | gcs (bucket {contrato}-assets atrás da CDN)
ASSETS_DRIVER=local           # local | gcs
ASSETS_BUCKET=
ASSETS_PUBLIC_URL=            # em prod: https://assets-entreredes.unooria.com
PERFIL_IMPORT_TOKEN=          # header x-perfil-token da ponte do Ato 1; vazio = rota desligada
# Planos de aula (exp-90): bucket PRIVADO {contrato}-planos. local em dev = storage-privado/
PLANOS_DRIVER=local           # local | gcs
PLANOS_BUCKET=
PLANOS_LOCAL_DIR=
PLANOS_IMPORT_TOKEN=          # header x-import-token do scripts/importar-referencias-plano.mjs; vazio = rota desligada
TELEMETRIA_TOPIC=             # vazio em dev = eventos logados no console
# Tranca do POST /telemetry/ingest (push do Pub/Sub). Vazias = rota FECHADA.
# Em prod: SA e audience da push subscription (terraform output
# telemetria_push_service_account / api_public_url).
TELEMETRIA_PUSH_SA=
TELEMETRIA_PUSH_AUDIENCE=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178   # hub + dev servers das experiências (5177 e 5178 faltavam)
PORT=3001

# ===== HUB (apps/hub) — copiar p/ apps/hub/.env.local =====
NEXT_PUBLIC_API_URL=http://localhost:3001
API_INTERNAL_URL=http://localhost:3001      # server-only (authorize/BFF)
NEXT_PUBLIC_CDN_EXP_URL=http://localhost:5173   # em prod: https://cdn.../exp; em dev sem manifesto, cada exp usa a porta de apps/hub/lib/experiencias-dev.ts
#NEXT_PUBLIC_CLARITY_PROJECT_ID=ybo0odt6cn   # Microsoft Clarity. AUSENTE = desligado, no hub E dentro das missões.
                                            # Deixada comentada de propósito: sessão de desenvolvimento e da suíte e2e
                                            # não deve cair no painel. Em prod entra por --build-arg (ver ADR-59).
#EXP_INTERNAL_URL=                          # server-only: de onde o hub LÊ o experiencia.json do bundle (viewport/aparelho). Endereço FIXO — serve quando há uma origem só (o CDN)
#EXP_INTERNAL_HOST=host.docker.internal    # server-only: troca só o HOST e preserva a porta de cada exp. É o que serve em dev/container, onde cada experiência tem um dev server numa porta (o docker-compose.dev.yml já define)

# ===== EXPERIÊNCIAS (apps/experiencias/*) — variáveis de BUILD do Vite =====
# exp-02-unootube: base dos 21 mp4 (fora do git). Vazio = ./videos (public/videos, gitignorado, em dev).
# Em prod: https://<cdn-assets>/exp-02-unootube/videos
VITE_VIDEOS_BASE_URL=
HUB_ORIGIN=http://localhost:3000
# PERFIL PORTÁTIL — o documento que a criança leva ao sair da REDE.
# CONTRATO_ID identifica o EMISSOR dentro do arquivo; sem ele a emissão responde
# 503, porque um documento cujo emissor não se identifica não vale nada na rede
# de destino (é por ele e pelo HUB_ORIGIN que o destino acha o JWKS).
CONTRATO_ID=contrato-dev
CONTRATO_NOME=Rede de Demonstração
# Do lado de QUEM RECEBE (api): de quem esta instalação aceita conferir
# assinatura. O `emissor.hub` vem de dentro do arquivo, ou seja, de um
# desconhecido — sem esta lista a api sairia buscando a URL que um arquivo
# mandou (SSRF). O documento SELECIONA entre estas origens; nunca introduz uma.
# Vazia = nenhum documento é verificado, e todos entram `nao-verificada`.
# Cada entrada é `origem` ou `origem=urlDoJwks` — a segunda forma porque o
# `emissor.hub` é o endereço do NAVEGADOR (mesma distinção de EXP_INTERNAL_HOST).
# JWKS por http só é aceito FORA de produção, e com aviso no log.
#   produção:      PORTABILIDADE_EMISSORES=https://hub.outra-rede.gov.br
#   dev no host:   PORTABILIDADE_EMISSORES=http://localhost:3000
#   dev em contêiner (é o default do compose):
PORTABILIDADE_EMISSORES=http://localhost:3000=http://hub:3000/.well-known/jwks.json
AUTH_SECRET=troque-me
# Par RS256 que assina os tokens de experiência (gerar com:
# `node apps/hub/scripts/gerar-chave-token.mjs`). Em prod: Secret Manager.
TOKEN_SIGNING_KEY_PEM=
# OIDC/WSO2 (futuro): presença de AUTH_WSO2_ISSUER registra o provider.
AUTH_WSO2_ISSUER=
AUTH_WSO2_CLIENT_ID=
AUTH_WSO2_CLIENT_SECRET=

# ── exp-70-vila-do-lume ──────────────────────────────────────────────────────
# Nenhuma env. A experiência não usa IA, não usa bucket e NÃO tem prazo de
# retenção declarado (decisão de 2026-08-26): o `payload` bruto vive enquanto o
# contrato durar, e em troca o reprocessamento do perfil fica preservado.
# Se um contrato exigir prazo, ele volta COM a rotina que o cumpre.
