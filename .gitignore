# Assets gerados em dev (ASSETS_DRIVER=local)
storage/
apps/api/storage/
# Planos de aula em dev (PLANOS_DRIVER=local) — privado, fora do static /assets
storage-privado/
apps/api/storage-privado/

# Prints dos walkthroughs.
#
# `testes/` INTEIRA, e não só `testes/walkthrough-*/`: o padrão antigo deixava de
# fora justamente as pastas que o CLAUDE.md documenta (`testes/wt-prof-vila`,
# `testes/wt-ato1`), e um `git add` distraído levaria centenas de PNG de 2x para
# o histórico. Esta pasta é saída de teste — nada dela é entregável.
testes/

# Mídia pesada das experiências (>2MB vai para o bucket de assets, não para o git)
apps/experiencias/exp04ef1b/public/videos/

# Auxiliares do LaTeX (documentacao-latex/). O main.pdf É versionado de
# propósito: é entregável de projeto, e quem precisa dele não tem TeX instalado.
documentacao-latex/build/
documentacao-latex/*.aux
documentacao-latex/*.bbl
documentacao-latex/*.blg
documentacao-latex/*.lof
documentacao-latex/*.lot
documentacao-latex/*.toc
documentacao-latex/*.out
documentacao-latex/*.fls
documentacao-latex/*.fdb_latexmk
documentacao-latex/*.synctex.gz

# Skills do Claude
# `.agents/` é do Antigravity: `skills/` é instalação local de cada máquina e
# fica fora; `rules/` é VERSIONADO — são symlinks para docs/regras/, para que o
# Antigravity leia a mesma fonte que o Claude e o Codex leem (ADR-102).
.agents/*
!.agents/rules/
skills-lock.json

# `.claude/` inteira fica fora — EXCETO as regras de permissão do projeto, que
# são versionadas: elas valem para quem clonar o repo, não só para esta máquina
# (ADR-55). Note que é `.claude/*`, não `.claude/`: com o diretório excluído o
# git nem desce nele, e o `!` de dentro nunca chega a ser avaliado.
.claude/*
!.claude/settings.json
# `.claude/rules/` também é versionado, pela mesma razão: symlinks para
# docs/regras/, com `paths:` no frontmatter da FONTE (ADR-102).
!.claude/rules/

# Lista de contas de demonstração que o seed escreve (login, nome, CPF e senha
# na mesma linha). Gente inventada, mas não é coisa que se versiona — e ela se
# refaz sozinha a cada `pnpm --filter @edu/api seed`.
credenciais-*.csv

# Arquivos de macOS
.DS_Store

# Os PDFs oficiais da BNCC: fonte do extrator, não do produto.
# Passam de 2 MB cada (regra do AGENTS.md), e o que o código consome é o extrato
# versionado em apps/api/src/curriculo/dados/*.ts. Como rebaixá-los está no
# README da pasta, junto da armadilha do rascunho do Ensino Médio.
documentos-fonte/**/*.pdf

graphify-out/