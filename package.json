{
  "name": "plataforma-unooria",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "turbo dev",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d --remove-orphans",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f api hub exp08ef1b exp02em1b exp07ef1b app-70 app-90 app-91",
    "docker:dev:deps": "docker compose -f docker-compose.dev.yml run --rm deps",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "new:exp": "node scripts/create-experiencia.mjs",
    "worktree": "node scripts/worktree.mjs",
    "lint:all": "eslint apps packages scripts"
  },
  "pnpm": {
    "overrides": {
      "@unooria/design-system>next": "16.3.3",
      "@nestjs/platform-express>multer": "2.2.0",
      "@nestjs/swagger>js-yaml": "4.3.1",
      "lodash@4.17.21": "4.18.1",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "tmp@<0.2.7": "0.2.7",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "ajv@8.12.0": "8.18.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.2",
    "axe-core": "4.10.3",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "mammoth": "^1",
    "pdf-parse": "^2",
    "playwright": "^1.62.1",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.35.3",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8"
  }
}
