{
  "name": "plataforma-unooria",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d --remove-orphans",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f api hub exp-01 exp-02 exp-70 exp-90 exp-91",
    "docker:dev:deps": "docker compose -f docker-compose.dev.yml run --rm deps",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "new:exp": "node scripts/create-experiencia.mjs",
    "lint:all": "eslint apps packages scripts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "mammoth": "^1",
    "pdf-parse": "^2",
    "playwright": "^1.62.1",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8"
  }
}
